# Environment Configuration untuk PRIMA BPS Kabupaten Banyuwangi
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=prima-bps-banyuwangi-akip-secret-key-2025

# Database Configuration (MySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=prima_akip_banyuwangi
DATABASE_URL=mysql+pymysql://root:@localhost:3306/prima_akip_banyuwangi

# Upload Configuration
MAX_CONTENT_LENGTH=33554432 # 32MB max file size
UPLOAD_FOLDER=app/static/uploads/documents

# SSO BPS (Single Sign-On OAuth2 / Keycloak)
# Dapatkan Client ID dan Secret dari Tim IPDS / Pusdatin BPS
SSO_BPS_CLIENT_ID=
SSO_BPS_CLIENT_SECRET=
SSO_BPS_AUTH_URL=https://sso.bps.go.id/auth/realms/pegawai-bps/protocol/openid-connect/auth
SSO_BPS_TOKEN_URL=https://sso.bps.go.id/auth/realms/pegawai-bps/protocol/openid-connect/token
SSO_BPS_USERINFO_URL=https://sso.bps.go.id/auth/realms/pegawai-bps/protocol/openid-connect/userinfo
SSO_BPS_REDIRECT_URI=


