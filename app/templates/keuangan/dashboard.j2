{% extends 'base.j2' %}

{% block title %}Dashboard Tracking Keuangan - LENTERA BPS Banyuwangi{% endblock %}

{% block content %}
<div class="space-y-6">

    <!-- 1. Header Halaman Modern & Berkelas (Harmonized Executive Card) -->
    <div class="bg-white/90 backdrop-blur-xl rounded-3xl p-5 sm:p-6 border border-slate-200/80 shadow-[0_4px_20px_-4px_rgba(20,43,74,0.03)] relative overflow-hidden">
        <div class="absolute -right-10 -top-10 w-56 h-56 bg-gradient-to-br from-blue-500/10 via-sky-300/10 to-transparent rounded-full blur-2xl pointer-events-none"></div>
        <div class="absolute right-1/3 -bottom-12 w-64 h-64 bg-gradient-to-tr from-sky-400/5 to-transparent rounded-full blur-2xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-5">
            <!-- Left: Breadcrumb, Icon, Title & Badges -->
            <div class="flex items-start sm:items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-white p-1.5 border border-blue-200/80 shadow-md shadow-blue-500/15 flex items-center justify-center flex-shrink-0">
                    <img src="{{ url_for('static', filename='images/logo_keuangan.svg') }}" alt="Logo Tracking Keuangan" class="w-full h-full object-contain">
                </div>
                <div>
                    <div class="flex items-center gap-1.5 text-[11px] text-slate-400 mb-1">
                        <a href="{{ url_for('dashboard.index') }}" class="hover:text-slate-600 transition flex items-center gap-1">
                            <i data-lucide="home" class="w-3 h-3"></i> LENTERA
                        </a>
                        <span>/</span>
                        <span class="text-slate-700 font-semibold">Tracking Keuangan</span>
                    </div>
                    
                    <div class="flex flex-wrap items-center gap-2.5">
                        <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-slate-900">Tracking & Realisasi Anggaran</h1>
                        <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-[11px] font-bold bg-blue-50 text-blue-700 border border-blue-200/70 shadow-2xs">
                            <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
                            DIPA Satker 429215 BPS
                        </span>
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200/70">
                            Serapan {{ persentase_serapan }}%
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 mt-1">Pengelolaan pagu MAK, verifikasi usulan anggaran, persetujuan PPK, dan realisasi SP2D BPS Banyuwangi</p>
                </div>
            </div>
            
            <!-- Right: Action Buttons -->
            <div class="flex flex-wrap items-center gap-2 pt-1 lg:pt-0">
                <a href="{{ url_for('keuangan.persetujuan') }}" 
                   class="h-9 px-4 rounded-full border border-slate-200/90 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs shadow-2xs transition-all flex items-center gap-1.5 active:scale-95 hover:border-slate-300">
                    <i data-lucide="check-square" class="w-3.5 h-3.5 text-sky-600"></i>
                    <span>Persetujuan PPK</span>
                </a>
                <a href="{{ url_for('keuangan.rekapitulasi') }}" 
                   class="h-9 px-4 rounded-full border border-slate-200/90 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs shadow-2xs transition-all flex items-center gap-1.5 active:scale-95 hover:border-slate-300">
                    <i data-lucide="bar-chart-3" class="w-3.5 h-3.5 text-blue-600"></i>
                    <span>Rekap DIPA</span>
                </a>
                <button type="button" 
                        onclick="openModalPengajuan()" 
                        class="h-9 px-4 rounded-full bg-gradient-to-r from-blue-600 via-blue-600 to-sky-500 hover:opacity-95 text-white font-bold text-xs shadow-sm shadow-blue-600/25 active:scale-95 transition-all flex items-center gap-1.5">
                    <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                    <span>Ajukan Anggaran</span>
                </button>
            </div>
        </div>
    </div>

    <!-- 2. Modern KPI Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-4">
        
        <!-- Total Pagu DIPA -->
        <div class="bg-white rounded-2xl p-4.5 border border-slate-200/70 shadow-[0_1px_3px_rgba(0,0,0,0.03)] hover:shadow-md hover:border-slate-300 transition-all group flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-500">
                <span class="text-xs font-medium">Total Pagu DIPA</span>
                <div class="w-8 h-8 rounded-lg bg-slate-100 text-slate-600 ring-1 ring-slate-500/10 flex items-center justify-center group-hover:scale-105 transition-transform">
                    <i data-lucide="landmark" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="my-2">
                <div class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight font-sans">Rp {{ "{:,}".format(total_pagu_akun).replace(',', '.') }}</div>
            </div>
            <p class="text-[11px] text-slate-400 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                <span>Alokasi seluruh MAK</span>
            </p>
        </div>

        <!-- Total Realisasi SP2D -->
        <div class="bg-white rounded-2xl p-4.5 border border-slate-200/70 shadow-[0_1px_3px_rgba(0,0,0,0.03)] hover:shadow-md hover:border-slate-300 transition-all group flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-500">
                <span class="text-xs font-medium">Realisasi SP2D</span>
                <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 ring-1 ring-blue-500/10 flex items-center justify-center group-hover:scale-105 transition-transform">
                    <i data-lucide="check-check" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="my-2">
                <div class="text-xl sm:text-2xl font-extrabold text-blue-600 tracking-tight font-sans">Rp {{ "{:,}".format(total_realisasi).replace(',', '.') }}</div>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">
                    Serapan: {{ persentase_serapan }}%
                </span>
            </div>
        </div>

        <!-- Sisa Pagu Tersedia -->
        <div class="bg-white rounded-2xl p-4.5 border border-slate-200/70 shadow-[0_1px_3px_rgba(0,0,0,0.03)] hover:shadow-md hover:border-slate-300 transition-all group flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-500">
                <span class="text-xs font-medium">Sisa Pagu Tersedia</span>
                <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 ring-1 ring-blue-500/10 flex items-center justify-center group-hover:scale-105 transition-transform">
                    <i data-lucide="pie-chart" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="my-2">
                <div class="text-xl sm:text-2xl font-extrabold text-blue-600 tracking-tight font-sans">Rp {{ "{:,}".format(sisa_anggaran).replace(',', '.') }}</div>
            </div>
            <p class="text-[11px] text-slate-400 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                <span>Belum terserap</span>
            </p>
        </div>

        <!-- Menunggu PPK -->
        <div class="bg-white rounded-2xl p-4.5 border border-slate-200/70 shadow-[0_1px_3px_rgba(0,0,0,0.03)] hover:shadow-md hover:border-slate-300 transition-all group flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-500">
                <span class="text-xs font-medium">Menunggu PPK</span>
                <div class="w-8 h-8 rounded-lg bg-sky-50 text-sky-600 ring-1 ring-sky-500/10 flex items-center justify-center group-hover:scale-105 transition-transform">
                    <i data-lucide="clock" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="my-2">
                <div class="text-xl sm:text-2xl font-extrabold text-sky-600 tracking-tight font-sans">{{ menunggu_persetujuan }} <span class="text-sm font-semibold text-slate-400">Pengajuan</span></div>
            </div>
            <p class="text-[11px] text-slate-400 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
                <span>Perlu persetujuan</span>
            </p>
        </div>

    </div>

    <!-- ============================================================== -->
    <!-- ALUR TRANSAKSI & REALISASI ANGGARAN DIPA BPS BANYUWANGI       -->
    <!-- Menjelaskan tahapan proses dari Usulan hingga Pencairan SP2D   -->
    <!-- ============================================================== -->
    <div class="bg-white rounded-2xl p-4 sm:p-4.5 border border-slate-200/80 shadow-xs">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3.5">
            <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center border border-blue-200/60 shadow-2xs">
                    <i data-lucide="git-commit" class="w-3.5 h-3.5"></i>
                </div>
                <div>
                    <h2 class="text-xs font-bold text-slate-800">Alur Transaksi & Realisasi Anggaran DIPA Satker 429215</h2>
                    <p class="text-[10px] text-slate-400">Tahapan transparan dari usulan rincian kegiatan, verifikasi PPK, hingga pencairan SP2D</p>
                </div>
            </div>
            <span class="text-[10px] font-bold text-blue-700 bg-blue-50 px-2.5 py-0.5 rounded-full border border-blue-200/60 hidden sm:inline-block">
                SOP Keuangan BPS
            </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
            <!-- Langkah 1: Pengajuan Anggaran -->
            <a href="{{ url_for('keuangan.pengajuan') }}" class="p-3 rounded-xl bg-slate-50/70 hover:bg-blue-50/60 border border-slate-200/70 hover:border-blue-300 transition-all group flex items-center gap-2.5">
                <span class="w-6 h-6 rounded-lg bg-blue-100 text-blue-700 font-black text-[11px] flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform shadow-2xs">1</span>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center justify-between">
                        <h3 class="text-xs font-bold text-slate-800 group-hover:text-blue-700 transition-colors">Pengajuan Anggaran</h3>
                        <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-slate-400 group-hover:translate-x-0.5 transition-transform"></i>
                    </div>
                    <p class="text-[10px] text-slate-500 truncate">Input akun, volume & honor kegiatan</p>
                </div>
            </a>

            <!-- Langkah 2: Persetujuan Anggaran -->
            <a href="{{ url_for('keuangan.persetujuan') }}" class="p-3 rounded-xl bg-slate-50/70 hover:bg-blue-50/60 border border-slate-200/70 hover:border-blue-300 transition-all group flex items-center gap-2.5">
                <span class="w-6 h-6 rounded-lg bg-blue-100 text-blue-700 font-black text-[11px] flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform shadow-2xs">2</span>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center justify-between">
                        <h3 class="text-xs font-bold text-slate-800 group-hover:text-blue-700 transition-colors">Persetujuan Anggaran</h3>
                        <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-slate-400 group-hover:translate-x-0.5 transition-transform"></i>
                    </div>
                    <p class="text-[10px] text-slate-500 truncate">Verifikasi & persetujuan usulan</p>
                </div>
            </a>

            <!-- Langkah 3: Pencairan Anggaran -->
            <a href="{{ url_for('keuangan.realisasi') }}" class="p-3 rounded-xl bg-slate-50/70 hover:bg-blue-50/60 border border-slate-200/70 hover:border-blue-300 transition-all group flex items-center gap-2.5">
                <span class="w-6 h-6 rounded-lg bg-blue-100 text-blue-700 font-black text-[11px] flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform shadow-2xs">3</span>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center justify-between">
                        <h3 class="text-xs font-bold text-slate-800 group-hover:text-blue-700 transition-colors">Pencairan Anggaran</h3>
                        <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-slate-400 group-hover:translate-x-0.5 transition-transform"></i>
                    </div>
                    <p class="text-[10px] text-slate-500 truncate">Pencatatan pencairan dana</p>
                </div>
            </a>

            <!-- Langkah 4: Rekapitulasi Keuangan -->
            <a href="{{ url_for('keuangan.rekapitulasi') }}" class="p-3 rounded-xl bg-slate-50/70 hover:bg-blue-50/60 border border-slate-200/70 hover:border-blue-300 transition-all group flex items-center gap-2.5">
                <span class="w-6 h-6 rounded-lg bg-blue-100 text-blue-700 font-black text-[11px] flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform shadow-2xs">4</span>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center justify-between">
                        <h3 class="text-xs font-bold text-slate-800 group-hover:text-blue-700 transition-colors">Rekapitulasi Keuangan</h3>
                        <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-slate-400 group-hover:translate-x-0.5 transition-transform"></i>
                    </div>
                    <p class="text-[10px] text-slate-500 truncate">Ringkasan sisa pagu & realisasi</p>
                </div>
            </a>
        </div>
    </div>

    <!-- 3. Charts Section with Balanced Heights -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch">
        
        <!-- Chart 1: Bar Chart Pagu vs Realisasi -->
        <div class="lg:col-span-2 bg-white rounded-3xl p-6 border border-slate-200/80 shadow-soft flex flex-col justify-between h-full">
            <div class="flex items-center justify-between pb-3.5 border-b border-slate-100 mb-4">
                <div>
                    <h2 class="text-sm font-bold text-slate-800">Perbandingan Pagu vs Realisasi per Kategori Belanja</h2>
                    <p class="text-[11px] text-slate-400">Honor Petugas Lapangan, Perjalanan Dinas, Belanja Bahan, dan Daya Jasa Satker</p>
                </div>
                <div class="w-8 h-8 rounded-lg bg-slate-50 text-slate-400 flex items-center justify-center">
                    <i data-lucide="bar-chart-3" class="w-4 h-4 text-blue-500"></i>
                </div>
            </div>
            
            <div class="h-64 relative flex items-center justify-center">
                {% if pagu_per_kat and pagu_per_kat|sum > 0 %}
                <canvas id="chartKeuanganKategori"></canvas>
                {% else %}
                <div class="w-full h-full rounded-2xl border-2 border-dashed border-slate-200/80 bg-slate-50/50 flex flex-col items-center justify-center text-center p-6">
                    <div class="w-11 h-11 rounded-2xl bg-blue-50 text-blue-500 flex items-center justify-center mb-2.5 ring-1 ring-blue-500/10">
                        <i data-lucide="bar-chart-3" class="w-5 h-5"></i>
                    </div>
                    <p class="text-xs font-bold text-slate-700">Belum Ada Pagu & Realisasi</p>
                    <p class="text-[11px] text-slate-400 max-w-xs mt-0.5">Grafik alokasi pagu vs realisasi anggaran akan tampil otomatis saat data akun dimasukkan.</p>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Serapan Anggaran & Daya Serap BPS -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-soft flex flex-col justify-between h-full">
            <div>
                <div class="pb-3.5 border-b border-slate-100 mb-4 flex items-center justify-between">
                    <div>
                        <h2 class="text-sm font-bold text-slate-800">Tingkat Penyerapan Anggaran</h2>
                        <p class="text-[11px] text-slate-400">Indikator kinerja pelaksanaan anggaran (IKPA)</p>
                    </div>
                    <div class="w-8 h-8 rounded-lg bg-slate-50 text-slate-400 flex items-center justify-center">
                        <i data-lucide="trending-up" class="w-4 h-4 text-blue-500"></i>
                    </div>
                </div>

                <div class="space-y-4 my-2">
                    <div>
                        <div class="flex justify-between text-xs font-bold mb-1.5">
                            <span class="text-slate-600">Daya Serap Kumulatif</span>
                            <span class="text-blue-600 font-mono">{{ persentase_serapan }}%</span>
                        </div>
                        <div class="w-full h-2.5 rounded-full bg-slate-100 overflow-hidden">
                            <div class="h-full bg-blue-500 rounded-full transition-all duration-500" style="width: {{ persentase_serapan }}%"></div>
                        </div>
                    </div>

                    <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100 space-y-2.5 text-xs">
                        <div class="flex justify-between items-center">
                            <span class="text-slate-500 text-[11px]">Total Diajukan:</span>
                            <span class="font-bold text-slate-800 font-mono">Rp {{ "{:,}".format(total_anggaran_diajukan).replace(',', '.') }}</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-slate-500 text-[11px]">Disetujui PPK:</span>
                            <span class="font-bold text-blue-600 font-mono">Rp {{ "{:,}".format(total_anggaran_disetujui).replace(',', '.') }}</span>
                        </div>
                        <div class="flex justify-between items-center pt-1.5 border-t border-slate-200/60">
                            <span class="text-slate-500 text-[11px]">Telah Dicairkan (SP2D):</span>
                            <span class="font-bold text-blue-600 font-mono">Rp {{ "{:,}".format(total_realisasi).replace(',', '.') }}</span>
                        </div>
                    </div>
                </div>
            </div>

            <a href="{{ url_for('keuangan.rekapitulasi') }}" class="mt-4 text-center text-xs font-semibold text-blue-600 hover:text-blue-700 block py-2.5 rounded-xl bg-blue-50/80 hover:bg-blue-100 transition">
                Buka Matriks Rekapitulasi Keuangan &rarr;
            </a>
        </div>

    </div>

    <!-- 4. Content Split: Recent Requests & Realizations -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Table Pengajuan Terbaru with Full Detail (Volume, Akun Database & Akun BPS) -->
        <div class="lg:col-span-2 bg-white rounded-3xl p-6 border border-slate-200/80 shadow-soft">
            <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
                <div>
                    <h2 class="text-base font-bold text-slate-800">Daftar Pengajuan Anggaran Terbaru</h2>
                    <p class="text-xs text-slate-400">Verifikasi usulan honor petugas, tim BPS, dan operasional kegiatan</p>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" 
                            onclick="openModalPengajuan()"
                            class="px-3 py-1.5 rounded-full bg-blue-50 hover:bg-blue-100 text-blue-600 font-bold text-xs transition flex items-center gap-1">
                        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                        <span>Pengajuan Baru</span>
                    </button>
                    <a href="{{ url_for('keuangan.pengajuan') }}" class="text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center gap-1 transition">
                        <span>Lihat Semua</span>
                        <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                    </a>
                </div>
            </div>

            <div class="overflow-x-auto rounded-2xl border border-slate-100">
                <table class="w-full text-left text-xs table-modern">
                    <thead>
                        <tr class="bg-slate-50/80 border-b border-slate-200/80 text-slate-500 font-bold uppercase text-[10px] tracking-wider">
                            <th class="py-3 px-3.5 whitespace-nowrap">No. Pengajuan</th>
                            <th class="py-3 px-3.5 whitespace-nowrap">Judul & Rincian Volume</th>
                            <th class="py-3 px-3.5 whitespace-nowrap">Akun MAK</th>
                            <th class="py-3 px-3.5 whitespace-nowrap">Alokasi Akun BPS</th>
                            <th class="py-3 px-3.5 whitespace-nowrap">Jumlah (Rp)</th>
                            <th class="py-3 px-3.5 whitespace-nowrap text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for item in transaksi_terbaru %}
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="py-3 px-3.5 whitespace-nowrap font-mono font-bold text-slate-900">
                                <div>{{ item.nomor_pengajuan }}</div>
                                <div class="text-[10px] text-slate-400 font-sans font-normal">{{ item.tanggal_pengajuan.strftime('%d/%m/%Y') if item.tanggal_pengajuan else '-' }}</div>
                            </td>
                            <td class="py-3 px-3.5 min-w-[180px]">
                                <div class="text-xs font-bold text-slate-800">{{ item.judul_pengajuan }}</div>
                                <div class="text-[10px] text-slate-500 mt-0.5 flex items-center gap-1.5">
                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-slate-100 font-mono text-[9px] text-slate-700 font-bold border border-slate-200">
                                        {{ item.volume_kegiatan or 1 }} {{ item.satuan_volume or 'Orang/Kegiatan' }}
                                    </span>
                                    {% if item.tarif_satuan and item.tarif_satuan > 0 %}
                                    <span class="text-[9px] text-slate-400">@ Rp {{ "{:,}".format(item.tarif_satuan).replace(',', '.') }}</span>
                                    {% endif %}
                                </div>
                                <div class="text-[10px] text-slate-400 mt-0.5">{{ item.kegiatan.nama_kegiatan if item.kegiatan else 'Operasional Rutin Kantor' }}</div>
                            </td>
                            <td class="py-3 px-3.5 whitespace-nowrap text-slate-600">
                                <div class="font-bold text-slate-700 font-mono text-xs flex items-center gap-1">
                                    <span class="px-1.5 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200 font-mono text-[10px] font-bold">{{ item.akun.kode_akun }}</span>
                                </div>
                                <div class="text-[10px] text-slate-500 font-semibold truncate max-w-[140px]" title="{{ item.akun.nama_akun }}">{{ item.akun.nama_akun }}</div>
                                <div class="text-[10px] text-slate-400">{{ item.komponen.nama_komponen }}</div>
                            </td>
                            <td class="py-3 px-3.5 whitespace-nowrap">
                                {% if item.is_akun_bps %}
                                <div class="space-y-0.5">
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 font-bold text-[9px] border border-blue-200 shadow-2xs">
                                        <i data-lucide="check-circle-2" class="w-3 h-3 text-blue-600"></i> Akun BPS: IYA
                                    </span>
                                    <div class="text-[10px] font-bold text-slate-700 truncate max-w-[140px]">
                                        {{ item.ketua_tim.nama_lengkap if item.ketua_tim else 'Tim BPS' }}
                                    </div>
                                    <div class="text-[9px] text-slate-400">
                                        {{ item.peran_tim or 'Ketua Tim' }} &bull; <span class="font-mono font-bold text-blue-600">Rp {{ "{:,}".format(item.honor_pengelola or 0).replace(',', '.') }}</span>
                                    </div>
                                </div>
                                {% else %}
                                <div>
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 font-semibold text-[9px] border border-slate-200">
                                        <i data-lucide="circle-dashed" class="w-3 h-3 text-slate-400"></i> Akun BPS: TIDAK
                                    </span>
                                    <div class="text-[9px] text-slate-400 mt-0.5">Lapangan/Mitra Saja</div>
                                </div>
                                {% endif %}
                            </td>
                            <td class="py-3 px-3.5 whitespace-nowrap font-mono font-bold text-slate-800 text-xs">
                                <div>Rp {{ "{:,}".format(item.jumlah_diajukan).replace(',', '.') }}</div>
                            </td>
                            <td class="py-3 px-3.5 whitespace-nowrap text-center">
                                {% if item.status == 'DISETUJUI' %}
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200 shadow-2xs">DISETUJUI</span>
                                {% elif item.status == 'DITOLAK' %}
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200 shadow-2xs">DITOLAK</span>
                                {% else %}
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-sky-50 text-sky-700 border border-sky-200 shadow-2xs">MENUNGGU</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="6" class="py-12 text-center text-slate-400">
                                <div class="flex flex-col items-center justify-center gap-2 max-w-sm mx-auto">
                                    <div class="w-12 h-12 rounded-2xl bg-blue-50 border border-blue-100 text-blue-500 flex items-center justify-center shadow-sm shadow-blue-500/10 mb-0.5">
                                        <i data-lucide="receipt" class="w-5 h-5"></i>
                                    </div>
                                    <p class="font-bold text-slate-800 text-xs">Belum Ada Pengajuan Anggaran</p>
                                    <p class="text-[11px] text-slate-400">Klik tombol "Ajukan Anggaran" di atas untuk membuat usulan pencairan baru.</p>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Realisasi SPM/SP2D Terbaru -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-soft flex flex-col justify-between">
            <div>
                <div class="pb-4 border-b border-slate-100 mb-4 flex items-center justify-between">
                    <div>
                        <h2 class="text-base font-bold text-slate-800">Realisasi SP2D Terbaru</h2>
                        <p class="text-xs text-slate-400">Pencairan anggaran KPPN</p>
                    </div>
                    <a href="{{ url_for('keuangan.realisasi') }}" class="text-xs text-blue-600 font-semibold hover:underline">Kelola &rarr;</a>
                </div>
                <div class="space-y-3">
                    {% for r in realisasi_terbaru %}
                    <div class="p-3.5 rounded-2xl bg-blue-50/50 border border-blue-100/80 hover:bg-blue-50 transition">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-xs font-mono font-bold text-blue-900">{{ r.nomor_spm_sp2d }}</span>
                            <span class="text-[10px] text-slate-400">{{ r.tanggal_realisasi }}</span>
                        </div>
                        <div class="text-xs font-black text-blue-700 font-mono mb-1">Rp {{ "{:,}".format(r.jumlah_realisasi).replace(',', '.') }}</div>
                        <p class="text-[11px] text-slate-600 truncate">{{ r.keterangan or r.pengajuan.judul_pengajuan }}</p>
                    </div>
                    {% else %}
                    <div class="py-8 text-center text-slate-400">
                        <i data-lucide="check-circle" class="w-8 h-8 mx-auto text-slate-300 mb-1.5"></i>
                        <p class="text-xs text-slate-600 font-semibold">Belum ada realisasi anggaran.</p>
                        <p class="text-[11px] text-slate-400">Pencatatan nomor SP2D akan muncul di sini.</p>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

    </div>

</div>

<!-- ============================================================== -->
<!-- MODAL FORM PENGAJUAN ANGGARAN (Lengkap dengan Toggle Akun BPS) -->
<!-- ============================================================== -->
<div id="modalPengajuan" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white rounded-3xl max-w-2xl w-full p-6 shadow-2xl my-8 border border-slate-100 max-h-[92vh] overflow-y-auto">
        
        <!-- Modal Header -->
        <div class="flex items-center justify-between pb-3.5 border-b border-slate-100 mb-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 flex items-center justify-center border border-blue-500/20">
                    <i data-lucide="file-plus" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="text-base font-black text-slate-800">Form Usulan Pengajuan Anggaran</h3>
                    <p class="text-[11px] text-slate-500">Mata anggaran, volume kegiatan, serta alokasi honor tim pengelola BPS</p>
                </div>
            </div>
            <button onclick="closeModalPengajuan()" class="p-1.5 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <form action="{{ url_for('keuangan.create_pengajuan') }}" method="POST" class="space-y-4">
            
            <!-- 1. Judul Pengajuan -->
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Judul / Keperluan Pengajuan Anggaran *</label>
                <input type="text" name="judul_pengajuan" required placeholder="Contoh: Honor Pencacah & Tim Pengelola Survei Angkatan Kerja Nasional (Sakernas)" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition">
            </div>

            <!-- 2. Pilihan Akun (MAK) & Komponen Anggaran -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Mata Anggaran (MAK) dari Database *</label>
                    <select name="akun_id" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 bg-white">
                        {% for a in akun_options %}
                        <option value="{{ a.id }}">{{ a.kode_akun }} - {{ a.nama_akun }} ({{ a.kategori }})</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Komponen Anggaran *</label>
                    <select name="komponen_id" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 bg-white">
                        {% for k in komponen_options %}
                        <option value="{{ k.id }}">{{ k.kode_komponen }} - {{ k.nama_komponen }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <!-- 3. Kegiatan Terkait -->
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Kegiatan Terkait (Sensus / Survei)</label>
                <select name="kegiatan_id" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 bg-white">
                    <option value="">-- Operasional Rutin / Kegiatan Kantor --</option>
                    {% for keg in kegiatan_options %}
                    <option value="{{ keg.id }}">{{ keg.nama_kegiatan }}</option>
                    {% endfor %}
                </select>
            </div>
            
            <!-- 4. Rincian Volume & Tarif Lapangan (Mitra / Beban Utama) -->
            <div class="p-4 bg-slate-50/80 rounded-2xl border border-slate-200 space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-black text-slate-800 flex items-center gap-1.5">
                        <i data-lucide="calculator" class="w-4 h-4 text-blue-600"></i>
                        <span>Rincian Volume Kegiatan Lapangan</span>
                    </span>
                    <span class="text-[10px] font-semibold text-slate-500">Auto-Calculate</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <!-- Volume -->
                    <div>
                        <label class="block text-[11px] font-bold text-slate-600 mb-1">Volume Kegiatan</label>
                        <input type="number" id="calcVol" name="volume_kegiatan" value="10" min="1" oninput="calcTotal()" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs font-bold font-mono focus:ring-2 focus:ring-blue-500/20">
                    </div>
                    <!-- Satuan Volume -->
                    <div>
                        <label class="block text-[11px] font-bold text-slate-600 mb-1">Satuan Volume</label>
                        <select name="satuan_volume" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs bg-white focus:ring-2 focus:ring-blue-500/20">
                            <option value="Orang / Bulan (O-B)">Orang / Bulan (O-B)</option>
                            <option value="Orang / Kegiatan (O-K)">Orang / Kegiatan (O-K)</option>
                            <option value="Dokumen / Kuesioner">Dokumen / Kuesioner</option>
                            <option value="Paket / Kegiatan">Paket / Kegiatan</option>
                            <option value="Orang / Hari (O-H)">Orang / Hari (O-H)</option>
                        </select>
                    </div>
                    <!-- Tarif Satuan -->
                    <div>
                        <label class="block text-[11px] font-bold text-slate-600 mb-1">Tarif Satuan SBM (Rp)</label>
                        <input type="number" id="calcTarif" name="tarif_satuan" value="1500000" min="0" step="10000" oninput="calcTotal()" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs font-bold font-mono focus:ring-2 focus:ring-blue-500/20">
                    </div>
                </div>

                <div class="flex items-center justify-between pt-1 border-t border-slate-200/60 text-xs">
                    <span class="text-slate-500 text-[11px]">Subtotal Biaya Lapangan:</span>
                    <span id="previewSubtotalLapangan" class="font-mono font-bold text-slate-800">Rp 15.000.000</span>
                </div>
            </div>

            <!-- ============================================================== -->
            <!-- 5. FITUR KUNCI: TOGGLE AKUN BPS (IYA / TIDAK)                 -->
            <!-- ============================================================== -->
            <div class="p-4 rounded-2xl border-2 transition-all duration-300" id="containerToggleAkunBps" style="border-color: #cbd5e1; background-color: #f8fafc;">
                
                <input type="hidden" name="is_akun_bps" id="inputIsAkunBps" value="0">

                <div class="flex items-center justify-between gap-3">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-black text-slate-800">Alokasi Honor Tim Pengelola BPS?</span>
                            <span class="px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider bg-blue-100 text-blue-700">Akun BPS</span>
                        </div>
                        <p class="text-[11px] text-slate-500 mt-0.5">Apakah pengajuan ini menyertakan honor pengelolaan untuk Ketua Tim / Pegawai BPS?</p>
                    </div>

                    <!-- Switch Button Modern (TIDAK vs IYA) -->
                    <div class="flex items-center p-1 bg-slate-200/80 rounded-xl shadow-inner flex-shrink-0">
                        <button type="button" id="btnToggleTidak" onclick="setAkunBpsToggle(false)" class="px-3.5 py-1.5 rounded-lg text-xs font-black transition-all bg-white text-slate-800 shadow-sm">
                            TIDAK
                        </button>
                        <button type="button" id="btnToggleIya" onclick="setAkunBpsToggle(true)" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all text-slate-500 hover:text-slate-800">
                            IYA
                        </button>
                    </div>
                </div>

                <!-- Sub-Panel Input Alokasi Tim Pengelola BPS (Tampil saat IYA) -->
                <div id="panelTimBps" class="hidden mt-4 pt-4 border-t border-blue-200/60 space-y-3">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <!-- Dropdown Pegawai / Ketua Tim -->
                        <div>
                            <label class="block text-[11px] font-bold text-slate-700 mb-1">Ketua Tim / Pegawai BPS Terlibat *</label>
                            <select name="ketua_tim_id" id="selectKetuaTim" class="w-full px-3 py-2 rounded-xl border border-blue-200 text-xs bg-white focus:ring-2 focus:ring-blue-500/20">
                                {% for peg in pegawai_options %}
                                <option value="{{ peg.id }}">{{ peg.nama_lengkap }} ({{ peg.jabatan }} - Tim {{ peg.tim_kerja }})</option>
                                {% endfor %}
                            </select>
                        </div>
                        
                        <!-- Peran Tim -->
                        <div>
                            <label class="block text-[11px] font-bold text-slate-700 mb-1">Peran dalam Tim Pengelola BPS</label>
                            <select name="peran_tim" id="selectPeranTim" class="w-full px-3 py-2 rounded-xl border border-blue-200 text-xs bg-white focus:ring-2 focus:ring-blue-500/20">
                                <option value="Ketua Tim Kerja">Ketua Tim Kerja</option>
                                <option value="Penanggung Jawab Teknis">Penanggung Jawab Teknis</option>
                                <option value="Koordinator Lapangan">Koordinator Lapangan</option>
                                <option value="Pengolah Data / Sekretariat">Pengolah Data / Sekretariat</option>
                            </select>
                        </div>
                    </div>

                    <!-- Input Honor Pengelolaan / Honor Ketua Tim -->
                    <div>
                        <label class="block text-[11px] font-bold text-slate-700 mb-1">Honor Pengelolaan / Honor Ketua Tim BPS (Rp) *</label>
                        <input type="number" id="calcHonorPengelola" name="honor_pengelola" value="1200000" min="0" step="10000" oninput="calcTotal()" class="w-full px-3 py-2 rounded-xl border border-blue-200 text-xs font-bold font-mono focus:ring-2 focus:ring-blue-500/20">
                        <p class="text-[10px] text-slate-400 mt-0.5">Alokasi honor manajerial / ketua tim sesuai standar pagu DIPA BPS Banyuwangi.</p>
                    </div>
                </div>
            </div>

            <!-- 6. Total Keseluruhan Diajukan -->
            <div class="p-4 rounded-2xl bg-blue-50 border border-blue-200 flex items-center justify-between">
                <div>
                    <span class="block text-[11px] font-bold text-blue-800">Total Nilai Usulan Anggaran:</span>
                    <span class="text-[10px] text-blue-600" id="labelRincianTotal">Biaya Lapangan</span>
                </div>
                <div class="text-right">
                    <span id="previewTotalDiajukan" class="text-xl font-black font-mono text-blue-600">Rp 15.000.000</span>
                    <input type="hidden" name="jumlah_diajukan" id="inputJumlahDiajukan" value="15000000">
                </div>
            </div>

            <!-- Keterangan Tambahan -->
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Catatan / Keterangan Tambahan</label>
                <textarea name="keterangan" rows="2" placeholder="Catatan teknis alokasi DIPA / dasar usulan nota dinas..." class="w-full px-3.5 py-2 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-blue-500/20"></textarea>
            </div>

            <!-- Modal Footer -->
            <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2.5">
                <button type="button" onclick="closeModalPengajuan()" class="px-4 py-2 rounded-xl text-xs font-bold text-slate-500 hover:bg-slate-100 transition">Batal</button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-md shadow-blue-600/20 transition flex items-center gap-1.5">
                    <i data-lucide="send" class="w-3.5 h-3.5"></i>
                    <span>Kirim Pengajuan ke PPK</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const ctxKategori = document.getElementById('chartKeuanganKategori');
    if (ctxKategori) {
        new Chart(ctxKategori, {
            type: 'bar',
            data: {
                labels: {{ kategori_labels|tojson }},
                datasets: [
                    {
                        label: 'Pagu Awal (Rp)',
                        data: {{ pagu_per_kat|tojson }},
                        backgroundColor: '#3B82F6',
                        borderRadius: 8
                    },
                    {
                        label: 'Realisasi SP2D (Rp)',
                        data: {{ real_per_kat|tojson }},
                        backgroundColor: '#0EA5E9',
                        borderRadius: 8
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                barPercentage: 0.65,
                categoryPercentage: 0.75,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return 'Rp ' + (value / 1000000).toLocaleString('id-ID') + ' Jt';
                            }
                        },
                        grid: { color: 'rgba(226, 232, 240, 0.6)' }
                    },
                    x: {
                        grid: { display: false }
                    }
                },
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': Rp ' + context.parsed.y.toLocaleString('id-ID');
                            }
                        }
                    }
                }
            }
        });
    }

    calcTotal();
});

function openModalPengajuan() {
    document.getElementById('modalPengajuan').classList.remove('hidden');
    calcTotal();
}

function closeModalPengajuan() {
    document.getElementById('modalPengajuan').classList.add('hidden');
}

function setAkunBpsToggle(isIya) {
    const inputIsAkun = document.getElementById('inputIsAkunBps');
    const btnTidak = document.getElementById('btnToggleTidak');
    const btnIya = document.getElementById('btnToggleIya');
    const panelTim = document.getElementById('panelTimBps');
    const container = document.getElementById('containerToggleAkunBps');

    if (isIya) {
        inputIsAkun.value = "1";
        btnIya.className = "px-3.5 py-1.5 rounded-lg text-xs font-black transition-all bg-blue-600 text-white shadow-sm";
        btnTidak.className = "px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all text-slate-500 hover:text-slate-800";
        panelTim.classList.remove('hidden');
        container.style.borderColor = "#93c5fd";
        container.style.backgroundColor = "#eff6ff";
    } else {
        inputIsAkun.value = "0";
        btnTidak.className = "px-3.5 py-1.5 rounded-lg text-xs font-black transition-all bg-white text-slate-800 shadow-sm";
        btnIya.className = "px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all text-slate-500 hover:text-slate-800";
        panelTim.classList.add('hidden');
        container.style.borderColor = "#cbd5e1";
        container.style.backgroundColor = "#f8fafc";
    }
    calcTotal();
}

function calcTotal() {
    const vol = parseInt(document.getElementById('calcVol')?.value || 0);
    const tarif = parseInt(document.getElementById('calcTarif')?.value || 0);
    const subtotalLap = vol * tarif;

    const previewSubtotalLap = document.getElementById('previewSubtotalLapangan');
    if (previewSubtotalLap) {
        previewSubtotalLap.innerText = 'Rp ' + subtotalLap.toLocaleString('id-ID');
    }

    const isAkunBps = document.getElementById('inputIsAkunBps')?.value === "1";
    let honorPengelola = 0;
    if (isAkunBps) {
        honorPengelola = parseInt(document.getElementById('calcHonorPengelola')?.value || 0);
    }

    const grandTotal = subtotalLap + honorPengelola;
    const previewTotal = document.getElementById('previewTotalDiajukan');
    const inputTotal = document.getElementById('inputJumlahDiajukan');
    const labelRincian = document.getElementById('labelRincianTotal');

    if (previewTotal) {
        previewTotal.innerText = 'Rp ' + grandTotal.toLocaleString('id-ID');
    }
    if (inputTotal) {
        inputTotal.value = grandTotal;
    }
    if (labelRincian) {
        if (isAkunBps) {
            labelRincian.innerText = 'Biaya Lapangan (Rp ' + subtotalLap.toLocaleString('id-ID') + ') + Tim BPS (Rp ' + honorPengelola.toLocaleString('id-ID') + ')';
        } else {
            labelRincian.innerText = 'Biaya Lapangan Murni (Tanpa Honor Tim Pengelola)';
        }
    }
}
</script>
{% endblock %}
