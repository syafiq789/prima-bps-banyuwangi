{% extends 'base.j2' %}

{% block title %}Rekapitulasi Kinerja Pegawai - LENTERA BPS Banyuwangi{% endblock %}

{% block content %}
<div class="space-y-6">

    <!-- 1. Header Halaman Modern Executive Blue -->
    <div style="background: linear-gradient(135deg, #0F2547 0%, #173B6D 55%, #1D4ED8 100%);"
         class="rounded-3xl p-5 sm:p-6 text-white shadow-xl shadow-blue-950/15 border border-blue-400/20 relative overflow-hidden">
        <div class="absolute -right-12 -top-12 w-60 h-60 bg-sky-400/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute left-1/3 -bottom-16 w-64 h-64 bg-blue-400/15 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-5">
            <!-- Left: Breadcrumb, Logo, Title & Badges -->
            <div class="flex items-start sm:items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-white/95 p-1.5 shadow-lg shadow-black/20 ring-2 ring-white/25 flex items-center justify-center flex-shrink-0">
                    <img src="{{ url_for('static', filename='images/logo_pegawai.svg') }}" alt="Logo Kinerja Pegawai" class="w-full h-full object-contain">
                </div>
                <div>
                    <div class="flex items-center gap-1.5 text-[11px] text-blue-200/80 mb-1.5">
                        <a href="{{ url_for('dashboard.index') }}" class="hover:text-white transition flex items-center gap-1">
                            <i data-lucide="home" class="w-3 h-3"></i> LENTERA
                        </a>
                        <span class="text-blue-300/50">/</span>
                        <a href="{{ url_for('pegawai.dashboard') }}" class="hover:text-white transition">Kinerja Pegawai</a>
                        <span class="text-blue-300/50">/</span>
                        <span class="text-white font-semibold">Laporan Kinerja</span>
                    </div>
                    
                    <div class="flex flex-wrap items-center gap-2.5">
                        <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-white">Laporan Kinerja Pegawai</h1>
                        <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-[11px] font-semibold bg-white/15 text-sky-100 border border-white/20 backdrop-blur-sm">
                            <span class="w-1.5 h-1.5 rounded-full bg-sky-300"></span>
                            Evaluasi Kinerja BPS
                        </span>
                    </div>
                    <p class="text-xs text-blue-100/80 mt-1.5">Ringkasan total tugas, pekerjaan selesai, dan nilai capaian kinerja pegawai BPS Kabupaten Banyuwangi</p>
                </div>
            </div>
            
            <!-- Right: Action Button -->
            <div class="flex items-center gap-2 pt-1 lg:pt-0">
                <a href="{{ url_for('pegawai.dashboard') }}" 
                   class="h-10 px-4 rounded-xl bg-white/10 hover:bg-white/20 text-white border border-white/20 font-semibold text-xs transition-all flex items-center gap-1.5 backdrop-blur-sm">
                    <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
                    <span>Dashboard Pegawai</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Ringkasan Kinerja Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-4">
        <!-- Total Pegawai -->
        <div class="bg-white rounded-2xl p-4.5 border border-slate-200/70 shadow-[0_1px_3px_rgba(0,0,0,0.03)] hover:shadow-md hover:border-slate-300 transition-all group flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-500">
                <span class="text-xs font-medium">Pegawai BPS</span>
                <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 ring-1 ring-blue-500/10 flex items-center justify-center group-hover:scale-105 transition-transform">
                    <i data-lucide="users" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="my-2">
                <div class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight font-sans">{{ total_peg }}</div>
            </div>
            <p class="text-[11px] text-slate-400 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                <span>Pegawai organik tercatat</span>
            </p>
        </div>

        <!-- Total Tugas -->
        <div class="bg-white rounded-2xl p-4.5 border border-slate-200/70 shadow-[0_1px_3px_rgba(0,0,0,0.03)] hover:shadow-md hover:border-slate-300 transition-all group flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-500">
                <span class="text-xs font-medium">Total Penugasan</span>
                <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 ring-1 ring-blue-500/10 flex items-center justify-center group-hover:scale-105 transition-transform">
                    <i data-lucide="check-square" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="my-2">
                <div class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight font-sans">{{ total_tugas }}</div>
            </div>
            <p class="text-[11px] text-slate-400 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                <span>Tugas kerja terakumulasi</span>
            </p>
        </div>

        <!-- Tugas Selesai -->
        <div class="bg-white rounded-2xl p-4.5 border border-slate-200/70 shadow-[0_1px_3px_rgba(0,0,0,0.03)] hover:shadow-md hover:border-slate-300 transition-all group flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-500">
                <span class="text-xs font-medium">Tugas Selesai</span>
                <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 ring-1 ring-blue-500/10 flex items-center justify-center group-hover:scale-105 transition-transform">
                    <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="my-2">
                <div class="text-2xl sm:text-3xl font-extrabold text-blue-600 tracking-tight font-sans">{{ total_selesai }}</div>
            </div>
            <p class="text-[11px] text-slate-400 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                <span>Progres 100% tuntas</span>
            </p>
        </div>

        <!-- Rata-Rata Capaian -->
        <div class="bg-white rounded-2xl p-4.5 border border-slate-200/70 shadow-[0_1px_3px_rgba(0,0,0,0.03)] hover:shadow-md hover:border-slate-300 transition-all group flex flex-col justify-between">
            <div class="flex items-center justify-between text-slate-500">
                <span class="text-xs font-medium">Rata-Rata Capaian</span>
                <div class="w-8 h-8 rounded-lg bg-sky-50 text-sky-600 ring-1 ring-sky-500/10 flex items-center justify-center group-hover:scale-105 transition-transform">
                    <i data-lucide="pie-chart" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="my-2">
                <div class="text-2xl sm:text-3xl font-extrabold text-sky-600 tracking-tight font-sans">{{ avg_total }}%</div>
            </div>
            <p class="text-[11px] text-slate-400 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
                <span>Indeks produktivitas pegawai</span>
            </p>
        </div>
    </div>

    <!-- 2. Tabel Rekapitulasi Capaian Kinerja -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-[0_4px_20px_-4px_rgba(20,43,74,0.04)] overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs table-modern">
                <thead>
                    <tr class="bg-slate-50/80 border-b border-slate-200/80 text-slate-500 uppercase font-bold text-[10px] tracking-wider">
                        <th class="py-3.5 px-4 whitespace-nowrap">NIP Pegawai</th>
                        <th class="py-3.5 px-4 whitespace-nowrap">Nama Pegawai BPS</th>
                        <th class="py-3.5 px-4 whitespace-nowrap">Tim Kerja Teknis</th>
                        <th class="py-3.5 px-4 whitespace-nowrap text-center">Total Tugas</th>
                        <th class="py-3.5 px-4 whitespace-nowrap text-center">Selesai (100%)</th>
                        <th class="py-3.5 px-4 whitespace-nowrap text-center">Dalam Proses</th>
                        <th class="py-3.5 px-4 whitespace-nowrap">Rata-Rata Capaian</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for r in rekap %}
                    <tr class="hover:bg-slate-50/80 transition group">
                        <!-- NIP -->
                        <td class="py-3.5 px-4 whitespace-nowrap">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-slate-100/90 text-slate-800 font-mono text-xs font-bold border border-slate-200/70 shadow-2xs">
                                {{ r.pegawai.nip }}
                            </span>
                        </td>

                        <!-- Nama Pegawai -->
                        <td class="py-3.5 px-4 whitespace-nowrap">
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-sky-100 to-blue-100 border border-sky-200/60 text-sky-700 flex items-center justify-center font-bold text-xs flex-shrink-0 shadow-2xs">
                                    {{ r.pegawai.nama_lengkap[:2]|upper }}
                                </div>
                                <div>
                                    <div class="font-bold text-slate-900 text-xs group-hover:text-sky-600 transition">{{ r.pegawai.nama_lengkap }}</div>
                                    <div class="text-[10px] text-slate-400">{{ r.pegawai.jabatan or 'Statistisi BPS' }}</div>
                                </div>
                            </div>
                        </td>

                        <!-- Tim Kerja -->
                        <td class="py-3.5 px-4 whitespace-nowrap">
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md font-semibold text-[11px] bg-blue-50/80 text-blue-700 border border-blue-200/60">
                                {{ r.pegawai.tim_kerja }}
                            </span>
                        </td>

                        <!-- Total Tugas -->
                        <td class="py-3.5 px-4 whitespace-nowrap text-center font-mono font-bold text-slate-800">
                            <span class="px-2 py-0.5 rounded-lg bg-slate-100 text-slate-700 text-xs font-bold">{{ r.total_aktivitas }} Tugas</span>
                        </td>

                        <!-- Selesai -->
                        <td class="py-3.5 px-4 whitespace-nowrap text-center">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200/60 font-mono">
                                {{ r.selesai }}
                            </span>
                        </td>

                        <!-- Dalam Proses -->
                        <td class="py-3.5 px-4 whitespace-nowrap text-center">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-sky-50 text-sky-700 border border-sky-200/60 font-mono">
                                {{ r.proses }}
                            </span>
                        </td>

                        <!-- Capaian -->
                        <td class="py-3.5 px-4 whitespace-nowrap">
                            <div class="w-36">
                                <div class="flex items-center justify-between text-[11px] font-bold mb-1">
                                    <span class="text-slate-500 font-medium">Capaian</span>
                                    <span class="{% if r.avg_pct == 100 %}text-blue-600{% elif r.avg_pct >= 70 %}text-blue-600{% else %}text-sky-600{% endif %} font-mono">{{ r.avg_pct }}%</span>
                                </div>
                                <div class="w-full h-2 rounded-full bg-slate-100 overflow-hidden">
                                    <div class="h-full {% if r.avg_pct == 100 %}bg-blue-500{% elif r.avg_pct >= 70 %}bg-blue-500{% else %}bg-sky-500{% endif %} rounded-full transition-all duration-300" style="width: {{ r.avg_pct }}%"></div>
                                </div>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="py-16 text-center text-slate-400">
                            <div class="flex flex-col items-center justify-center gap-2 max-w-sm mx-auto">
                                <div class="w-14 h-14 rounded-2xl bg-sky-50 border border-sky-100 text-sky-500 flex items-center justify-center shadow-sm shadow-sky-500/10 mb-1">
                                    <i data-lucide="bar-chart-2" class="w-6 h-6"></i>
                                </div>
                                <p class="font-bold text-slate-800 text-sm">Belum Ada Rekapitulasi</p>
                                <p class="text-xs text-slate-400">Data rekapitulasi akan terhitung otomatis saat pegawai BPS mencatat aktivitas tugas.</p>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}
