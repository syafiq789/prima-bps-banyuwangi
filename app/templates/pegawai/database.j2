{% extends 'base.j2' %}

{% block title %}Database Pegawai - LENTERA BPS Banyuwangi{% endblock %}

{% block content %}
<div class="space-y-6">

    <!-- 1. Header Halaman Modern Executive Blue -->
    <div style="background: linear-gradient(135deg, #0F2547 0%, #173B6D 55%, #1D4ED8 100%);"
         class="rounded-3xl p-5 sm:p-6 text-white shadow-xl shadow-blue-950/15 border border-blue-400/20 relative overflow-hidden">
        <!-- Decorative Soft Glows -->
        <div class="absolute -right-12 -top-12 w-60 h-60 bg-sky-400/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute left-1/3 -bottom-16 w-64 h-64 bg-blue-400/15 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-5">
            <!-- Left: Breadcrumb, Logo, Title & Badges -->
            <div class="flex items-start sm:items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-white/95 p-1.5 shadow-lg shadow-black/20 ring-2 ring-white/25 flex items-center justify-center flex-shrink-0">
                    <img src="{{ url_for('static', filename='images/logo_pegawai.svg') }}" alt="Logo Kinerja Pegawai" class="w-full h-full object-contain">
                </div>
                <div>
                    <div class="flex items-center gap-1.5 text-[11px] text-blue-200/80 mb-1.5">
                        <a href="{{ url_for('dashboard.index') }}" class="hover:text-white transition flex items-center gap-1">
                            <i data-lucide="home" class="w-3 h-3"></i> LENTERA
                        </a>
                        <span class="text-blue-300/50">/</span>
                        <a href="{{ url_for('pegawai.dashboard') }}" class="hover:text-white transition">Kinerja Pegawai</a>
                        <span class="text-blue-300/50">/</span>
                        <span class="text-white font-semibold">Data Pegawai</span>
                    </div>
                    
                    <div class="flex flex-wrap items-center gap-2.5">
                        <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-white">Data Pegawai BPS</h1>
                        <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-[11px] font-semibold bg-white/15 text-sky-100 border border-white/20 backdrop-blur-sm">
                            <span class="w-1.5 h-1.5 rounded-full bg-sky-300"></span>
                            BPS Banyuwangi (3510)
                        </span>
                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-blue-950/40 text-blue-100 border border-white/15">
                            {{ pegawai_list|length }} Pegawai
                        </span>
                    </div>
                    <p class="text-xs text-blue-100/80 mt-1.5">Kelola daftar pegawai, jabatan, dan penempatan tim kerja BPS Kabupaten Banyuwangi</p>
                </div>
            </div>
            
            <!-- Right: Action Button -->
            <div class="flex items-center gap-2 pt-1 lg:pt-0">
                <button type="button" 
                        onclick="document.getElementById('modalTambahPegawai').classList.remove('hidden')" 
                        class="h-10 px-5 rounded-xl bg-white hover:bg-blue-50 text-blue-700 font-bold text-xs shadow-lg shadow-black/15 active:scale-95 transition-all flex items-center gap-2">
                    <i data-lucide="user-plus" class="w-4 h-4"></i>
                    <span>Tambah Pegawai</span>
                </button>
            </div>
        </div>
    </div>

    <!-- 2. Filter Bar yang Minimalis & Sejajar -->
    <div class="bg-white rounded-2xl p-3 sm:p-3.5 border border-slate-200/80 shadow-2xs">
        <form method="GET" action="{{ url_for('pegawai.database') }}" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
            <!-- Input Pencarian -->
            <div class="relative flex-1">
                <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                <input type="text" 
                       name="search" 
                       value="{{ search }}" 
                       placeholder="Cari nama pegawai, NIP, atau jabatan..." 
                       class="w-full h-10 pl-10 pr-4 text-xs rounded-full bg-slate-50/70 hover:bg-slate-100/60 focus:bg-white border border-slate-200/80 focus:border-blue-500/40 focus:ring-4 focus:ring-blue-500/10 font-medium text-slate-800 placeholder:text-slate-400 transition-all outline-none">
            </div>

            <!-- Filter Tim Kerja -->
            <div class="flex items-center gap-2">
                <select name="tim" class="h-10 pl-4 pr-9 text-xs rounded-full border border-slate-200/80 bg-white font-semibold text-slate-700 hover:border-slate-300 focus:outline-none focus:border-blue-500 select-pill shadow-2xs transition-all">
                    <option value="">Semua Tim Kerja</option>
                    {% for t in all_tims %}
                    <option value="{{ t }}" {% if tim_filter == t %}selected{% endif %}>{{ t }}</option>
                    {% endfor %}
                    <option value="Tim Statistik Sosial" {% if tim_filter == 'Tim Statistik Sosial' %}selected{% endif %}>Tim Statistik Sosial</option>
                    <option value="Tim Statistik Produksi" {% if tim_filter == 'Tim Statistik Produksi' %}selected{% endif %}>Tim Statistik Produksi</option>
                    <option value="Tim Statistik Distribusi" {% if tim_filter == 'Tim Statistik Distribusi' %}selected{% endif %}>Tim Statistik Distribusi</option>
                    <option value="Tim Neraca Wilayah & Analisis Statistik" {% if tim_filter == 'Tim Neraca Wilayah & Analisis Statistik' %}selected{% endif %}>Tim Nerwilis</option>
                    <option value="Tim Pengolahan & TI (IPDS)" {% if tim_filter == 'Tim Pengolahan & TI (IPDS)' %}selected{% endif %}>Tim IPDS</option>
                    <option value="Subbagian Umum" {% if tim_filter == 'Subbagian Umum' %}selected{% endif %}>Subbagian Umum</option>
                </select>

                <!-- Tombol Submit Filter -->
                <button type="submit" class="h-10 px-5 rounded-full bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs shadow-sm active:scale-95 transition-all flex items-center gap-1.5 flex-shrink-0">
                    <i data-lucide="filter" class="w-3.5 h-3.5"></i>
                    <span>Filter</span>
                </button>

                {% if search or tim_filter %}
                <a href="{{ url_for('pegawai.database') }}" class="h-10 w-10 rounded-full text-blue-600 hover:bg-blue-50 border border-blue-200 transition-all flex items-center justify-center flex-shrink-0" title="Reset Filter">
                    <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
                </a>
                {% endif %}
            </div>
        </form>
    </div>

    <!-- 3. Tabel Database Pegawai Organik -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-[0_4px_20px_-4px_rgba(20,43,74,0.04)] overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs table-modern">
                <thead>
                    <tr class="bg-slate-50/80 border-b border-slate-200/80 text-slate-500 uppercase font-bold text-[10px] tracking-wider">
                        <th class="py-3.5 px-4 whitespace-nowrap">NIP / Identitas</th>
                        <th class="py-3.5 px-4 whitespace-nowrap">Nama Lengkap & Gelar</th>
                        <th class="py-3.5 px-4 whitespace-nowrap">Jabatan Kedinasan</th>
                        <th class="py-3.5 px-4 whitespace-nowrap">Tim Kerja Teknis</th>
                        <th class="py-3.5 px-4 whitespace-nowrap">Email Kedinasan</th>
                        <th class="py-3.5 px-4 whitespace-nowrap text-center">Status</th>
                        <th class="py-3.5 px-4 whitespace-nowrap text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for p in pegawai_list %}
                    <tr class="hover:bg-slate-50/80 transition group">
                        <!-- NIP -->
                        <td class="py-3.5 px-4 whitespace-nowrap">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-slate-100/90 text-slate-800 font-mono text-xs font-bold border border-slate-200/70 shadow-2xs">
                                {{ p.nip }}
                            </span>
                        </td>

                        <!-- Nama Lengkap -->
                        <td class="py-3.5 px-4 whitespace-nowrap">
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-blue-100 to-blue-100 border border-blue-200/60 text-blue-700 flex items-center justify-center font-bold text-xs flex-shrink-0 shadow-2xs">
                                    {{ p.nama_lengkap[:2]|upper }}
                                </div>
                                <div>
                                    <div class="font-bold text-slate-900 text-xs group-hover:text-blue-600 transition">{{ p.nama_lengkap }}</div>
                                    <div class="text-[10px] text-slate-400">Pegawai BPS Banyuwangi</div>
                                </div>
                            </div>
                        </td>

                        <!-- Jabatan -->
                        <td class="py-3.5 px-4 whitespace-nowrap">
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                                <i data-lucide="briefcase" class="w-3 h-3 text-slate-400"></i>
                                {{ p.jabatan or 'Statistisi Ahli' }}
                            </span>
                        </td>

                        <!-- Tim Kerja -->
                        <td class="py-3.5 px-4 whitespace-nowrap">
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md font-semibold text-[11px] bg-blue-50/80 text-blue-700 border border-blue-200/60">
                                <i data-lucide="users" class="w-3 h-3 text-blue-500"></i>
                                {{ p.tim_kerja }}
                            </span>
                        </td>

                        <!-- Email -->
                        <td class="py-3.5 px-4 whitespace-nowrap text-xs text-slate-600 font-mono">
                            {% if p.email %}
                            <div class="flex items-center gap-1.5 text-slate-700">
                                <i data-lucide="mail" class="w-3.5 h-3.5 text-slate-400 flex-shrink-0"></i>
                                <span class="hover:text-blue-600 transition">{{ p.email }}</span>
                            </div>
                            {% else %}
                            <span class="text-slate-400 italic text-[11px]">-</span>
                            {% endif %}
                        </td>

                        <!-- Status -->
                        <td class="py-3.5 px-4 whitespace-nowrap text-center">
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200/80 shadow-2xs">
                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span> AKTIF
                            </span>
                        </td>

                        <!-- Aksi -->
                        <td class="py-3.5 px-4 text-right whitespace-nowrap">
                            <form action="{{ url_for('pegawai.delete_pegawai', id=p.id) }}" method="POST" class="inline" onsubmit="return confirm('Hapus data pegawai {{ p.nama_lengkap }}?');">
                                <button type="submit" title="Hapus Pegawai" class="w-7 h-7 rounded-full text-slate-400 hover:text-blue-600 hover:bg-blue-50 border border-transparent hover:border-blue-200 transition flex items-center justify-center active:scale-90">
                                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="py-16 text-center text-slate-400">
                            <div class="flex flex-col items-center justify-center gap-2 max-w-sm mx-auto">
                                <div class="w-14 h-14 rounded-2xl bg-blue-50 border border-blue-100 text-blue-500 flex items-center justify-center shadow-sm shadow-blue-500/10 mb-1">
                                    <i data-lucide="users" class="w-6 h-6"></i>
                                </div>
                                <p class="font-bold text-slate-800 text-sm">Belum Ada Data Pegawai</p>
                                <p class="text-xs text-slate-400">Silakan tambahkan data pegawai BPS Kabupaten Banyuwangi.</p>
                                <button type="button" 
                                        onclick="document.getElementById('modalTambahPegawai').classList.remove('hidden')" 
                                        class="mt-3 h-9 px-4 rounded-full bg-gradient-to-r from-blue-600 to-blue-600 text-white text-xs font-bold shadow-sm shadow-blue-500/20 active:scale-95 transition-all">
                                    + Tambah Pegawai Baru
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Modal Tambah Pegawai (Modern & Executive Design) -->
<div id="modalTambahPegawai" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-md flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full shadow-2xl border border-slate-100 overflow-hidden animate-in fade-in zoom-in-95 duration-200">
        
        <!-- Header Modal Menarik -->
        <div class="bg-gradient-to-r from-blue-50/80 via-blue-50/40 to-white px-6 py-4.5 border-b border-blue-100/70 flex items-center justify-between">
            <div class="flex items-center gap-3.5">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-blue-600 to-blue-600 text-white flex items-center justify-center shadow-md shadow-blue-500/25 flex-shrink-0">
                    <i data-lucide="user-plus" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="text-base font-bold text-slate-900">Tambah Pegawai BPS</h3>
                    <p class="text-[11px] text-slate-500 mt-0.5">Formulir data induk pegawai BPS Kabupaten Banyuwangi</p>
                </div>
            </div>
            <button type="button" 
                    onclick="document.getElementById('modalTambahPegawai').classList.add('hidden')" 
                    class="w-8 h-8 rounded-full text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 transition flex items-center justify-center">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <!-- Form Body -->
        <form action="{{ url_for('pegawai.create_pegawai') }}" method="POST" class="p-6 space-y-4">
            
            <!-- NIP & Nama Lengkap -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                    <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">
                        NIP Pegawai (18 Digit) <span class="text-blue-500">*</span>
                    </label>
                    <input type="text" 
                           name="nip" 
                           required 
                           placeholder="Contoh: 198501012010011001" 
                           class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-white focus:bg-white focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/15 font-mono font-semibold text-slate-800 transition">
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">
                        Nama Lengkap & Gelar <span class="text-blue-500">*</span>
                    </label>
                    <input type="text" 
                           name="nama_lengkap" 
                           required 
                           placeholder="Contoh: Joko Susilo, S.Stat." 
                           class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-white focus:bg-white focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/15 font-medium text-slate-800 transition">
                </div>
            </div>

            <!-- Jabatan & Tim Kerja -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                    <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">
                        Jabatan Kedinasan <span class="text-blue-500">*</span>
                    </label>
                    <input type="text" 
                           name="jabatan" 
                           required 
                           placeholder="Contoh: Statistisi Ahli Muda" 
                           class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-white focus:bg-white focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/15 text-slate-800 transition">
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">
                        Tim Kerja BPS Banyuwangi <span class="text-blue-500">*</span>
                    </label>
                    <select name="tim_kerja" required class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-white focus:bg-white focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/15 font-semibold text-slate-700 transition">
                        <option value="Tim Statistik Sosial">Tim Statistik Sosial</option>
                        <option value="Tim Statistik Produksi">Tim Statistik Produksi</option>
                        <option value="Tim Statistik Distribusi">Tim Statistik Distribusi</option>
                        <option value="Tim Neraca Wilayah & Analisis Statistik">Tim Neraca Wilayah & Analisis Statistik</option>
                        <option value="Tim Pengolahan & TI (IPDS)">Tim Pengolahan & TI (IPDS)</option>
                        <option value="Subbagian Umum">Subbagian Umum</option>
                    </select>
                </div>
            </div>

            <!-- Email Kedinasan -->
            <div>
                <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">
                    Email Kedinasan BPS
                </label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                        <i data-lucide="mail" class="w-3.5 h-3.5"></i>
                    </span>
                    <input type="email" 
                           name="email" 
                           placeholder="nama.pegawai@bps.go.id" 
                           class="w-full pl-9 pr-3 py-2 text-xs rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-white focus:bg-white focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/15 font-mono text-slate-800 transition">
                </div>
            </div>

            <!-- Footer Action -->
            <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2">
                <button type="button" 
                        onclick="document.getElementById('modalTambahPegawai').classList.add('hidden')" 
                        class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 transition">
                    Batal
                </button>
                <button type="submit" 
                        class="px-5 py-2 rounded-xl bg-gradient-to-r from-blue-600 to-blue-600 hover:from-blue-700 hover:to-blue-700 text-white font-bold text-xs shadow-md shadow-blue-500/25 transition-all flex items-center gap-1.5 active:scale-95">
                    <i data-lucide="check" class="w-3.5 h-3.5"></i>
                    <span>Simpan Data Pegawai</span>
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
