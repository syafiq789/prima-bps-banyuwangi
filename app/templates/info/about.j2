{% extends 'base.j2' %}

{% block title %}Tentang PRIMA - BPS Kabupaten Banyuwangi{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto space-y-6">

    <!-- Hero Card -->
    <div class="bg-gradient-to-r from-[#0D1B2A] via-[#142B4A] to-[#1E3E66] text-white p-8 rounded-3xl shadow-card border border-slate-700/60 relative overflow-hidden">
        <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 text-sky-300 border border-blue-400/30 text-xs font-semibold uppercase tracking-wider mb-3">
                    <i data-lucide="shield-check" class="w-4 h-4"></i>
                    <span>Profil Aplikasi</span>
                </div>
                <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-white">
                    Tentang PRIMA
                </h1>
                <p class="text-base font-semibold text-sky-300 mt-1">
                    Pusat Arsip dan Manajemen AKIP Banyuwangi
                </p>
                <p class="text-xs sm:text-sm text-slate-300 italic mt-1 font-medium">
                    "{{ app_tagline }}"
                </p>
            </div>
            <div class="flex-shrink-0">
                <img src="{{ url_for('static', filename='images/logo_icon.svg') }}" alt="Logo PRIMA" class="w-28 h-28 object-contain drop-shadow-2xl">
            </div>
        </div>
    </div>

    <!-- Deskripsi Lengkap -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-card p-6 sm:p-8 space-y-6">
        <div>
            <h3 class="text-base font-bold text-slate-900 mb-2">Latar Belakang & Definisi</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                <strong>PRIMA (Pusat Arsip dan Manajemen AKIP Banyuwangi)</strong> merupakan platform digital terintegrasi untuk pengelolaan, penyimpanan, pengorganisasian, dan pemantauan dokumen administrasi serta dokumen Akuntabilitas Kinerja Instansi Pemerintah (AKIP) di lingkungan Badan Pusat Statistik Kabupaten Banyuwangi.
            </p>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mt-3">
                Aplikasi ini bertujuan mempermudah pencarian arsip, meningkatkan ketertiban dokumentasi, memantau kelengkapan dokumen, serta mendukung efektivitas dan akuntabilitas kinerja organisasi secara berkelanjutan.
            </p>
        </div>

        <!-- 4 Pilar AKIP -->
        <div class="pt-6 border-t border-slate-100">
            <h3 class="text-base font-bold text-slate-900 mb-4">4 Pilar Utama Manajemen AKIP BPS Banyuwangi</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="p-4 bg-blue-50/60 rounded-2xl border border-blue-100">
                    <div class="w-8 h-8 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-xs mb-2">1</div>
                    <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Perencanaan Kinerja</h4>
                    <p class="text-xs text-slate-600 mt-1">Pengelolaan Renstra, Rencana Kerja Tahunan (RKT), Perjanjian Kinerja (PK), Rencana Aksi, serta Indikator Kinerja Utama (IKU).</p>
                </div>

                <div class="p-4 bg-blue-50/60 rounded-2xl border border-blue-100">
                    <div class="w-8 h-8 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-xs mb-2">2</div>
                    <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Pengukuran Kinerja</h4>
                    <p class="text-xs text-slate-600 mt-1">Pemantauan metrik capaian output dan outcome secara berkala melalui evaluasi berkala dan pelaporan realisasi.</p>
                </div>

                <div class="p-4 bg-sky-50/60 rounded-2xl border border-sky-100">
                    <div class="w-8 h-8 rounded-xl bg-sky-600 text-white flex items-center justify-center font-bold text-xs mb-2">3</div>
                    <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Pelaporan Kinerja</h4>
                    <p class="text-xs text-slate-600 mt-1">Penyusunan Laporan Kinerja Instansi Pemerintah (LAKIP/LKjIP) tahunan beserta seluruh bukti dukung dan notula evaluasi.</p>
                </div>

                <div class="p-4 bg-blue-50/60 rounded-2xl border border-blue-100">
                    <div class="w-8 h-8 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-xs mb-2">4</div>
                    <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Evaluasi & Kelengkapan</h4>
                    <p class="text-xs text-slate-600 mt-1">Checklist kelengkapan berkas administrasi dan pemenuhan rekomendasi tindak lanjut hasil evaluasi internal maupun eksternal.</p>
                </div>
            </div>
        </div>

        <!-- Spesifikasi Teknologi Sistem LENTERA -->
        <div class="pt-6 border-t border-slate-100">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <i data-lucide="cpu" class="w-5 h-5 text-blue-600"></i>
                    Spesifikasi Arsitektur Teknologi
                </h3>
                <span class="text-xs font-bold px-3 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-200">
                    Production Stack
                </span>
            </div>
            
            <div class="overflow-x-auto rounded-2xl border border-slate-200/80 shadow-2xs">
                <table class="w-full text-xs text-left">
                    <thead class="bg-slate-50/90 text-slate-700 font-bold uppercase tracking-wider text-[10px] border-b border-slate-200/80">
                        <tr>
                            <th class="px-4 py-3 w-1/3">Komponen Arsitektur</th>
                            <th class="px-4 py-3">Teknologi yang Digunakan</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-600 font-medium">
                        <tr class="hover:bg-slate-50/50 transition">
                            <td class="px-4 py-2.5 font-bold text-slate-800">Front-End</td>
                            <td class="px-4 py-2.5">HTML5, CSS3, JavaScript, Bootstrap 5 / Tailwind CSS</td>
                        </tr>
                        <tr class="hover:bg-slate-50/50 transition">
                            <td class="px-4 py-2.5 font-bold text-slate-800">Back-End</td>
                            <td class="px-4 py-2.5">Python (Flask Framework)</td>
                        </tr>
                        <tr class="hover:bg-slate-50/50 transition">
                            <td class="px-4 py-2.5 font-bold text-slate-800">Basis Data</td>
                            <td class="px-4 py-2.5">MySQL 8</td>
                        </tr>
                        <tr class="hover:bg-slate-50/50 transition">
                            <td class="px-4 py-2.5 font-bold text-slate-800">ORM</td>
                            <td class="px-4 py-2.5">SQLAlchemy</td>
                        </tr>
                        <tr class="hover:bg-slate-50/50 transition">
                            <td class="px-4 py-2.5 font-bold text-slate-800">Autentikasi</td>
                            <td class="px-4 py-2.5">Session Auth &amp; Role-Based Access Control (RBAC)</td>
                        </tr>
                        <tr class="hover:bg-slate-50/50 transition">
                            <td class="px-4 py-2.5 font-bold text-slate-800">Pengujian</td>
                            <td class="px-4 py-2.5">Black Box Testing &amp; UAT (User Acceptance Testing)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Info Kontak & Lokasi -->
        <div class="pt-6 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs text-slate-500">
            <div>
                <p class="font-bold text-slate-800">Badan Pusat Statistik Kabupaten Banyuwangi</p>
                <p>Jl. Adi Sucipto No. 67, Sobo, Kec. Banyuwangi, Kabupaten Banyuwangi, Jawa Timur 68418</p>
            </div>
            <div class="text-right">
                <span class="inline-block px-3 py-1 bg-slate-100 text-navy-main font-bold rounded-xl">Versi Aplikasi: LENTERA v2.0</span>
            </div>
        </div>
    </div>

</div>
{% endblock %}

