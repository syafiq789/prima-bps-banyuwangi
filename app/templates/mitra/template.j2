{% extends 'base.j2' %}

{% block title %}Template & Upload Data - LENTERA BPS Banyuwangi{% endblock %}

{% block content %}
<div class="space-y-6">

    <!-- 1. Header Banner Executive Blue -->
    <div style="background: linear-gradient(135deg, #0F2547 0%, #173B6D 55%, #1D4ED8 100%);"
         class="rounded-3xl p-5 sm:p-6 text-white shadow-xl shadow-blue-950/15 border border-blue-400/20 relative overflow-hidden">
        <div class="absolute -right-12 -top-12 w-60 h-60 bg-sky-400/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute left-1/3 -bottom-16 w-64 h-64 bg-blue-400/15 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-5">
            <div class="flex items-start sm:items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-white/95 p-1.5 shadow-lg shadow-black/20 ring-2 ring-white/25 flex items-center justify-center flex-shrink-0">
                    <img src="{{ url_for('static', filename='images/logo_mitra.svg') }}" alt="Logo Monitoring Mitra" class="w-full h-full object-contain">
                </div>
                <div>
                    <div class="flex items-center gap-1.5 text-[11px] text-blue-200/80 mb-1.5">
                        <a href="{{ url_for('dashboard.index') }}" class="hover:text-white transition flex items-center gap-1">
                            <i data-lucide="home" class="w-3 h-3"></i> LENTERA
                        </a>
                        <span class="text-blue-300/50">/</span>
                        <a href="{{ url_for('mitra.dashboard') }}" class="hover:text-white transition">Monitoring Mitra</a>
                        <span class="text-blue-300/50">/</span>
                        <span class="text-white font-semibold">Template &amp; Upload</span>
                    </div>
                    <div class="flex flex-wrap items-center gap-2.5">
                        <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-white">Template &amp; Upload Data</h1>
                        <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-[11px] font-semibold bg-white/15 text-sky-100 border border-white/20 backdrop-blur-sm">
                            <span class="w-1.5 h-1.5 rounded-full bg-sky-300"></span>
                            Impor Otomatis (.CSV)
                        </span>
                    </div>
                    <p class="text-xs text-blue-100/80 mt-1.5">Unduh template, isi data, lalu upload agar langsung tersimpan dan tampil otomatis di tabel bawah.</p>
                </div>
            </div>

            <!-- Switcher Tab Langsung di Header -->
            <div class="inline-flex p-1 rounded-2xl bg-blue-950/45 border border-white/15 backdrop-blur-sm self-start lg:self-auto">
                <a href="{{ url_for('mitra.template', tab='kegiatan') }}"
                   class="px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 whitespace-nowrap {% if active_tab != 'mitra' %} bg-white text-blue-700 shadow-md {% else %} text-blue-100 hover:text-white {% endif %}">
                    <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
                    <span>Upload Kegiatan</span>
                    <span class="px-1.5 py-0.5 rounded-md text-[10px] font-extrabold {% if active_tab != 'mitra' %} bg-blue-100 text-blue-700 {% else %} bg-white/15 text-white {% endif %}">{{ total_kegiatan }}</span>
                </a>
                <a href="{{ url_for('mitra.template', tab='mitra') }}"
                   class="px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 whitespace-nowrap {% if active_tab == 'mitra' %} bg-white text-blue-700 shadow-md {% else %} text-blue-100 hover:text-white {% endif %}">
                    <i data-lucide="users" class="w-3.5 h-3.5"></i>
                    <span>Upload Data Mitra</span>
                    <span class="px-1.5 py-0.5 rounded-md text-[10px] font-extrabold {% if active_tab == 'mitra' %} bg-blue-100 text-blue-700 {% else %} bg-white/15 text-white {% endif %}">{{ total_mitra }}</span>
                </a>
            </div>
        </div>
    </div>

    {% if active_tab != 'mitra' %}
    <!-- ============================================================== -->
    <!-- MODE 1: UPLOAD KEGIATAN                                        -->
    <!-- ============================================================== -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">

        <!-- LANGKAH 1: TEMPLATE KEGIATAN -->
        <div class="lg:col-span-6 bg-white rounded-3xl p-6 border border-slate-200/80 shadow-soft flex flex-col justify-between">
            <div class="space-y-4">
                <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-xl bg-blue-600 text-white font-black text-xs flex items-center justify-center shadow-sm shadow-blue-600/25">1</span>
                        <div>
                            <h2 class="text-sm font-extrabold text-slate-900">Template Kegiatan</h2>
                            <p class="text-[11px] text-slate-500">Lihat format isian &amp; unduh file template sebelum upload</p>
                        </div>
                    </div>
                </div>

                <!-- Format Isian Ringkas -->
                <div class="p-3.5 rounded-2xl bg-blue-50/60 border border-blue-100 space-y-2">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-blue-700">Isian yang Dibutuhkan</span>
                    <div class="flex flex-wrap gap-1.5 text-[11px]">
                        <span class="px-2.5 py-1 rounded-lg bg-white border border-blue-200/80 text-slate-800 font-semibold">Nama Kegiatan</span>
                        <span class="px-2.5 py-1 rounded-lg bg-white border border-blue-200/80 text-blue-700 font-semibold">Tim Kerja</span>
                        <span class="px-2.5 py-1 rounded-lg bg-white border border-blue-200/80 text-slate-600 font-medium">Tahun</span>
                        <span class="px-2.5 py-1 rounded-lg bg-white border border-blue-200/80 text-slate-600 font-medium">Bulan</span>
                        <span class="px-2.5 py-1 rounded-lg bg-white border border-blue-200/80 text-slate-600 font-medium">Tanggal Mulai</span>
                        <span class="px-2.5 py-1 rounded-lg bg-white border border-blue-200/80 text-slate-600 font-medium">Tanggal Selesai</span>
                    </div>
                </div>

                <!-- 1 Contoh Baris -->
                <div class="overflow-x-auto rounded-2xl border border-slate-200/80">
                    <table class="w-full text-left text-[11px]">
                        <thead class="bg-slate-50 text-slate-500 font-bold uppercase text-[9px] border-b border-slate-200/80">
                            <tr>
                                <th class="py-2 px-3 whitespace-nowrap">Nama Kegiatan</th>
                                <th class="py-2 px-3 whitespace-nowrap">Tim Kerja</th>
                                <th class="py-2 px-3 whitespace-nowrap">Periode</th>
                            </tr>
                        </thead>
                        <tbody class="text-slate-700">
                            <tr>
                                <td class="py-2.5 px-3 font-semibold">Survei Harga Perdagangan Besar</td>
                                <td class="py-2.5 px-3 text-blue-700 font-semibold whitespace-nowrap">Tim Distribusi</td>
                                <td class="py-2.5 px-3 font-mono text-[10px] whitespace-nowrap">05 Jan &ndash; 31 Jan 2025</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="pt-4 mt-4 border-t border-slate-100">
                <a href="{{ url_for('mitra.download_template_kegiatan') }}"
                   class="w-full py-2.5 px-4 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 font-bold text-xs transition-all flex items-center justify-center gap-2">
                    <i data-lucide="download" class="w-4 h-4"></i>
                    <span>Unduh Template Kegiatan (.CSV)</span>
                </a>
            </div>
        </div>

        <!-- LANGKAH 2: UPLOAD KEGIATAN -->
        <div class="lg:col-span-6 bg-white rounded-3xl p-6 border border-blue-200/80 shadow-soft flex flex-col justify-between">
            <div class="flex items-center gap-3 mb-4">
                <span class="w-8 h-8 rounded-xl bg-blue-600 text-white font-black text-xs flex items-center justify-center shadow-sm shadow-blue-600/25">2</span>
                <div>
                    <h2 class="text-sm font-extrabold text-slate-900">Upload Kegiatan</h2>
                    <p class="text-[11px] text-slate-500">Pilih file template yang sudah diisi, data langsung masuk ke daftar</p>
                </div>
            </div>

            <form action="{{ url_for('mitra.upload_kegiatan') }}" method="POST" enctype="multipart/form-data" class="flex-1 flex flex-col justify-between gap-4">
                <div class="relative flex-1 min-h-[145px] border-2 border-dashed border-blue-300 hover:border-blue-500 rounded-2xl p-6 text-center bg-blue-50/40 hover:bg-blue-50/70 transition-all cursor-pointer group flex flex-col items-center justify-center">
                    <input type="file"
                           id="inputCsvKegiatan"
                           name="file"
                           accept=".csv,.txt"
                           required
                           onchange="updateFileNameDisplay(this, 'labelNamaFileKegiatan')"
                           class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10">
                    <div class="w-11 h-11 rounded-2xl bg-white text-blue-600 flex items-center justify-center mb-2 shadow-sm group-hover:scale-110 transition-transform pointer-events-none">
                        <i data-lucide="upload-cloud" class="w-5 h-5"></i>
                    </div>
                    <p class="text-xs font-bold text-slate-800 pointer-events-none">Klik atau seret file CSV Kegiatan ke sini</p>
                    <p class="text-[11px] text-slate-400 mt-0.5 pointer-events-none">Mendukung format .csv (pemisah koma / titik koma)</p>
                    <div id="labelNamaFileKegiatan" class="mt-2.5 text-xs font-bold text-blue-700 bg-white px-3 py-1 rounded-full border border-blue-200 shadow-2xs hidden pointer-events-none"></div>
                </div>

                <button type="submit"
                        class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-blue-600 to-sky-500 hover:opacity-95 text-white text-xs font-bold shadow-md shadow-blue-600/25 active:scale-[0.99] transition-all flex items-center justify-center gap-2">
                    <i data-lucide="upload" class="w-4 h-4"></i>
                    <span>Upload &amp; Simpan Otomatis</span>
                </button>
            </form>
        </div>
    </div>

    <!-- DAFTAR HASIL UPLOAD KEGIATAN -->
    <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-soft">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between pb-4 border-b border-slate-100 mb-4 gap-3.5">
            <div class="flex items-start sm:items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                    <i data-lucide="calendar-check-2" class="w-5 h-5"></i>
                </div>
                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <h2 class="text-base font-extrabold text-slate-900">Daftar Kegiatan Tersimpan</h2>
                        <span class="px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200/70 text-[10px] font-bold">
                            {{ kegiatan_list|length }} Kegiatan
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 mt-0.5">Otomatis terhubung ke menu <strong>Daftar Kegiatan</strong>, <strong>Penugasan Mitra</strong>, dan <strong>Laporan &amp; Honor</strong>.</p>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <div class="relative w-full sm:w-56">
                    <i data-lucide="search" class="w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                    <input type="text"
                           id="searchUploadedKegiatan"
                           onkeyup="filterUploadedKegiatan()"
                           placeholder="Cari nama kegiatan / tim..."
                           class="w-full pl-8 pr-3 py-2 text-xs rounded-xl border border-slate-200 bg-slate-50/70 focus:bg-white focus:border-blue-500 outline-none transition">
                </div>
                <a href="{{ url_for('mitra.monitoring') }}"
                   class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200/80 text-xs font-bold transition whitespace-nowrap">
                    <span>Daftar Kegiatan</span>
                    <i data-lucide="arrow-up-right" class="w-3.5 h-3.5"></i>
                </a>
                <a href="{{ url_for('mitra.rekapitulasi') }}"
                   class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition whitespace-nowrap">
                    <span>Laporan &amp; Honor</span>
                    <i data-lucide="arrow-up-right" class="w-3.5 h-3.5"></i>
                </a>
            </div>
        </div>

        <div class="flex items-center gap-1.5 overflow-x-auto pb-3 mb-2 scrollbar-none">
            {% for t_key, t_label in [('Semua', 'Semua Tim'), ('Tim Distribusi', 'Tim Distribusi'), ('Tim Neraca', 'Tim Neraca'), ('Tim Produksi', 'Tim Produksi'), ('Tim PLS', 'Tim PLS')] %}
            <a href="{{ url_for('mitra.template', tab='kegiatan', tim=t_key) }}"
               class="px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all whitespace-nowrap {% if tim_filter == t_key or (not tim_filter and t_key == 'Semua') %} bg-blue-600 text-white shadow-sm {% else %} bg-slate-100 hover:bg-slate-200 text-slate-600 {% endif %}">
                {{ t_label }}
            </a>
            {% endfor %}
        </div>

        <div class="overflow-x-auto max-h-[480px] overflow-y-auto rounded-2xl border border-slate-200/80">
            <table class="w-full text-left text-xs" id="tableUploadedKegiatan">
                <thead class="sticky top-0 z-10 bg-slate-50/95 backdrop-blur-sm border-b border-slate-200/80">
                    <tr class="text-slate-600 uppercase font-bold text-[10px] tracking-wider">
                        <th class="py-3.5 px-3.5 text-center w-10">No</th>
                        <th class="py-3.5 px-4">Nama Kegiatan</th>
                        <th class="py-3.5 px-4">Tim Kerja</th>
                        <th class="py-3.5 px-4">Jadwal Pelaksanaan</th>
                        <th class="py-3.5 px-4 text-center">Mitra</th>
                        <th class="py-3.5 px-4 text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for keg in kegiatan_list %}
                    <tr class="keg-upload-row hover:bg-blue-50/40 transition"
                        data-search="{{ (keg.nama_kegiatan ~ ' ' ~ (keg.tim_kerja or '') ~ ' ' ~ (keg.bulan or '') ~ ' ' ~ (keg.tahun or ''))|lower }}">
                        <td class="py-3.5 px-3.5 text-center font-mono text-slate-400 font-semibold">{{ loop.index }}</td>
                        <td class="py-3.5 px-4">
                            <div class="font-bold text-slate-900">{{ keg.nama_kegiatan }}</div>
                            <div class="text-[10px] text-slate-400 mt-0.5">Tahun {{ keg.tahun }} &bull; Bulan {{ keg.bulan or 'Semua Bulan' }}</div>
                        </td>
                        <td class="py-3.5 px-4 whitespace-nowrap">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200/70">{{ keg.tim_kerja }}</span>
                        </td>
                        <td class="py-3.5 px-4 whitespace-nowrap">
                            <div class="inline-flex items-center gap-1.5 font-mono text-[11px] text-slate-600 bg-slate-50 px-2.5 py-1 rounded-lg border border-slate-200/70">
                                <i data-lucide="calendar" class="w-3 h-3 text-blue-500"></i>
                                <span>{{ keg.tanggal_mulai }} s.d {{ keg.tanggal_selesai }}</span>
                            </div>
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            <span class="px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 font-bold text-[11px]">{{ keg.penugasan_mitra.count() }} Orang</span>
                        </td>
                        <td class="py-3.5 px-4 text-right whitespace-nowrap">
                            <a href="{{ url_for('mitra.monitoring_detail', kegiatan_id=keg.id) }}"
                               class="px-3 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-[11px] inline-flex items-center gap-1 shadow-xs transition">
                                <span>Detail</span>
                                <i data-lucide="arrow-right" class="w-3 h-3"></i>
                            </a>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" class="py-12 text-center text-slate-400 text-xs">
                            Belum ada data kegiatan. Unduh template di atas lalu upload file CSV Anda.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% else %}
    <!-- ============================================================== -->
    <!-- MODE 2: UPLOAD DATA MITRA                                      -->
    <!-- ============================================================== -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">

        <!-- LANGKAH 1: TEMPLATE DATA MITRA -->
        <div class="lg:col-span-6 bg-white rounded-3xl p-6 border border-slate-200/80 shadow-soft flex flex-col justify-between">
            <div class="space-y-4">
                <div class="flex items-center gap-3">
                    <span class="w-8 h-8 rounded-xl bg-blue-600 text-white font-black text-xs flex items-center justify-center shadow-sm shadow-blue-600/25">1</span>
                    <div>
                        <h2 class="text-sm font-extrabold text-slate-900">Template Data Mitra</h2>
                        <p class="text-[11px] text-slate-500">Lihat format isian &amp; unduh file template sebelum upload</p>
                    </div>
                </div>

                <div class="p-3.5 rounded-2xl bg-blue-50/60 border border-blue-100 space-y-2">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-blue-700">Isian yang Dibutuhkan</span>
                    <div class="flex flex-wrap gap-1.5 text-[11px]">
                        <span class="px-2.5 py-1 rounded-lg bg-white border border-blue-200/80 text-slate-800 font-semibold">ID Sobat</span>
                        <span class="px-2.5 py-1 rounded-lg bg-white border border-blue-200/80 text-slate-800 font-semibold">Nama</span>
                        <span class="px-2.5 py-1 rounded-lg bg-white border border-blue-200/80 text-slate-600 font-medium">Email</span>
                        <span class="px-2.5 py-1 rounded-lg bg-white border border-blue-200/80 text-slate-600 font-medium">Alamat</span>
                        <span class="px-2.5 py-1 rounded-lg bg-white border border-blue-200/80 text-slate-600 font-medium">Nomor HP</span>
                        <span class="px-2.5 py-1 rounded-lg bg-white border border-blue-200/80 text-slate-600 font-medium">Jenis Kelamin</span>
                        <span class="px-2.5 py-1 rounded-lg bg-white border border-blue-200/80 text-slate-600 font-medium">Desa</span>
                        <span class="px-2.5 py-1 rounded-lg bg-white border border-blue-200/80 text-blue-700 font-semibold">Kecamatan</span>
                    </div>
                </div>

                <div class="overflow-x-auto rounded-2xl border border-slate-200/80">
                    <table class="w-full text-left text-[11px]">
                        <thead class="bg-slate-50 text-slate-500 font-bold uppercase text-[9px] border-b border-slate-200/80">
                            <tr>
                                <th class="py-2 px-3 whitespace-nowrap">ID Sobat</th>
                                <th class="py-2 px-3 whitespace-nowrap">Nama</th>
                                <th class="py-2 px-3 whitespace-nowrap">Nomor HP</th>
                                <th class="py-2 px-3 whitespace-nowrap">Desa / Kecamatan</th>
                            </tr>
                        </thead>
                        <tbody class="text-slate-700">
                            <tr>
                                <td class="py-2.5 px-3 font-mono font-bold text-blue-600 whitespace-nowrap">35102025001</td>
                                <td class="py-2.5 px-3 font-semibold whitespace-nowrap">Budi Santoso</td>
                                <td class="py-2.5 px-3 font-mono text-[10px] whitespace-nowrap">085712345678</td>
                                <td class="py-2.5 px-3 whitespace-nowrap">Mojopanggung, Giri</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="pt-4 mt-4 border-t border-slate-100">
                <a href="{{ url_for('mitra.download_template_mitra') }}"
                   class="w-full py-2.5 px-4 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 font-bold text-xs transition-all flex items-center justify-center gap-2">
                    <i data-lucide="download" class="w-4 h-4"></i>
                    <span>Unduh Template Mitra (.CSV)</span>
                </a>
            </div>
        </div>

        <!-- LANGKAH 2: UPLOAD DATA MITRA -->
        <div class="lg:col-span-6 bg-white rounded-3xl p-6 border border-blue-200/80 shadow-soft flex flex-col justify-between">
            <div class="flex items-center gap-3 mb-4">
                <span class="w-8 h-8 rounded-xl bg-blue-600 text-white font-black text-xs flex items-center justify-center shadow-sm shadow-blue-600/25">2</span>
                <div>
                    <h2 class="text-sm font-extrabold text-slate-900">Upload Data Mitra</h2>
                    <p class="text-[11px] text-slate-500">Pilih file template yang sudah diisi, data otomatis tersimpan</p>
                </div>
            </div>

            <form action="{{ url_for('mitra.upload_mitra_from_template') }}" method="POST" enctype="multipart/form-data" class="flex-1 flex flex-col justify-between gap-4">
                <div class="relative flex-1 min-h-[145px] border-2 border-dashed border-blue-300 hover:border-blue-500 rounded-2xl p-6 text-center bg-blue-50/40 hover:bg-blue-50/70 transition-all cursor-pointer group flex flex-col items-center justify-center">
                    <input type="file"
                           id="inputCsvMitra"
                           name="file"
                           accept=".csv"
                           required
                           onchange="updateFileNameDisplay(this, 'labelNamaFileMitra')"
                           class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10">
                    <div class="w-11 h-11 rounded-2xl bg-white text-blue-600 flex items-center justify-center mb-2 shadow-sm group-hover:scale-110 transition-transform pointer-events-none">
                        <i data-lucide="users" class="w-5 h-5"></i>
                    </div>
                    <p class="text-xs font-bold text-slate-800 pointer-events-none">Klik atau seret file CSV Data Mitra ke sini</p>
                    <p class="text-[11px] text-slate-400 mt-0.5 pointer-events-none">Mendukung format .csv (UTF-8)</p>
                    <div id="labelNamaFileMitra" class="mt-2.5 text-xs font-bold text-blue-700 bg-white px-3 py-1 rounded-full border border-blue-200 shadow-2xs hidden pointer-events-none"></div>
                </div>

                <button type="submit"
                        class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-blue-600 to-sky-500 hover:opacity-95 text-white text-xs font-bold shadow-md shadow-blue-600/25 active:scale-[0.99] transition-all flex items-center justify-center gap-2">
                    <i data-lucide="upload" class="w-4 h-4"></i>
                    <span>Upload &amp; Simpan Otomatis</span>
                </button>
            </form>
        </div>
    </div>

    <!-- DAFTAR HASIL UPLOAD MITRA -->
    <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-soft">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between pb-4 border-b border-slate-100 mb-4 gap-3.5">
            <div class="flex items-start sm:items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                    <i data-lucide="users" class="w-5 h-5"></i>
                </div>
                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <h2 class="text-base font-extrabold text-slate-900">Daftar Mitra Tersimpan</h2>
                        <span class="px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200/70 text-[10px] font-bold">
                            {{ total_mitra }} Mitra Terdaftar
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 mt-0.5">Otomatis terhubung ke menu <strong>Data Mitra</strong>, <strong>Penugasan Mitra</strong>, dan <strong>Laporan &amp; Honor</strong>.</p>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <div class="relative w-full sm:w-60">
                    <i data-lucide="search" class="w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                    <input type="text"
                           id="searchUploadedMitra"
                           onkeyup="filterUploadedMitra()"
                           placeholder="Cari nama, ID Sobat, desa, kecamatan..."
                           class="w-full pl-8 pr-3 py-2 text-xs rounded-xl border border-slate-200 bg-slate-50/70 focus:bg-white focus:border-blue-500 outline-none transition">
                </div>
                <a href="{{ url_for('mitra.database') }}"
                   class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200/80 text-xs font-bold transition whitespace-nowrap">
                    <span>Data Mitra</span>
                    <i data-lucide="arrow-up-right" class="w-3.5 h-3.5"></i>
                </a>
                <a href="{{ url_for('mitra.rekapitulasi') }}"
                   class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition whitespace-nowrap">
                    <span>Laporan &amp; Honor</span>
                    <i data-lucide="arrow-up-right" class="w-3.5 h-3.5"></i>
                </a>
            </div>
        </div>

        <div class="overflow-x-auto max-h-[520px] overflow-y-auto rounded-2xl border border-slate-200/80">
            <table class="w-full text-left text-xs" id="tableUploadedMitra">
                <thead class="sticky top-0 z-10 bg-slate-50/95 backdrop-blur-sm border-b border-slate-200/80">
                    <tr class="text-slate-600 uppercase font-bold text-[10px] tracking-wider">
                        <th class="py-3.5 px-3.5 text-center w-10">No</th>
                        <th class="py-3.5 px-4">ID Sobat</th>
                        <th class="py-3.5 px-4">Nama &amp; Email</th>
                        <th class="py-3.5 px-4">Nomor HP</th>
                        <th class="py-3.5 px-4 text-center">Jenis Kelamin</th>
                        <th class="py-3.5 px-4">Desa &amp; Alamat</th>
                        <th class="py-3.5 px-4">Kecamatan</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for m in mitra_list %}
                    <tr class="mitra-upload-row hover:bg-blue-50/40 transition"
                        data-search="{{ (m.id_sobat ~ ' ' ~ m.nama_lengkap ~ ' ' ~ (m.email or '') ~ ' ' ~ (m.no_hp or '') ~ ' ' ~ (m.desa or '') ~ ' ' ~ (m.kecamatan or ''))|lower }}">
                        <td class="py-3.5 px-3.5 text-center font-mono text-slate-400 font-semibold">{{ loop.index }}</td>
                        <td class="py-3.5 px-4 whitespace-nowrap">
                            <span class="font-mono font-bold text-blue-700 bg-blue-50/70 px-2.5 py-1 rounded-lg border border-blue-100 text-[11px]">{{ m.id_sobat }}</span>
                        </td>
                        <td class="py-3.5 px-4">
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 font-extrabold text-[11px] flex items-center justify-center shrink-0">
                                    {{ (m.nama_lengkap or 'M')[:1]|upper }}
                                </div>
                                <div class="min-w-0">
                                    <div class="font-bold text-slate-900 leading-tight">{{ m.nama_lengkap }}</div>
                                    <div class="text-[10px] text-slate-400 truncate max-w-[200px]">{{ m.email or '-' }}</div>
                                </div>
                            </div>
                        </td>
                        <td class="py-3.5 px-4 font-mono text-[11px] text-slate-700 whitespace-nowrap">{{ m.no_hp or '-' }}</td>
                        <td class="py-3.5 px-4 text-center whitespace-nowrap">
                            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold {% if m.jenis_kelamin == 'Perempuan' %} bg-sky-50 text-sky-700 border border-sky-200/70 {% else %} bg-blue-50 text-blue-700 border border-blue-200/70 {% endif %}">
                                {{ m.jenis_kelamin or '-' }}
                            </span>
                        </td>
                        <td class="py-3.5 px-4">
                            <div class="font-semibold text-slate-800 text-[11px]">Desa {{ m.desa or '-' }}</div>
                            <div class="text-[10px] text-slate-400 leading-snug max-w-[240px] truncate" title="{{ m.alamat or '' }}">{{ m.alamat or '-' }}</div>
                        </td>
                        <td class="py-3.5 px-4 whitespace-nowrap">
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-100 text-slate-800 font-bold text-[11px]">
                                <i data-lucide="map-pin" class="w-3 h-3 text-blue-600"></i>
                                {{ m.kecamatan or '-' }}
                            </span>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="py-12 text-center text-slate-400 text-xs">Belum ada data mitra. Unduh template di atas lalu upload file CSV Anda.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

</div>

<script>
    function updateFileNameDisplay(input, targetId) {
        const label = document.getElementById(targetId);
        if (!label) return;
        if (input.files && input.files.length > 0) {
            label.textContent = "File siap diupload: " + input.files[0].name;
            label.classList.remove('hidden');
        } else {
            label.classList.add('hidden');
        }
    }

    function filterUploadedKegiatan() {
        const q = (document.getElementById('searchUploadedKegiatan')?.value || '').toLowerCase().trim();
        document.querySelectorAll('#tableUploadedKegiatan .keg-upload-row').forEach(row => {
            const hay = row.getAttribute('data-search') || '';
            row.style.display = hay.includes(q) ? '' : 'none';
        });
    }

    function filterUploadedMitra() {
        const q = (document.getElementById('searchUploadedMitra')?.value || '').toLowerCase().trim();
        document.querySelectorAll('#tableUploadedMitra .mitra-upload-row').forEach(row => {
            const hay = row.getAttribute('data-search') || '';
            row.style.display = hay.includes(q) ? '' : 'none';
        });
    }
</script>
{% endblock %}
