{% extends 'base.j2' %}

{% block title %}Dashboard Mitra - LENTERA BPS Banyuwangi{% endblock %}

{% block content %}
<div class="space-y-6">

    <!-- 1. Header Banner Executive Blue -->
    <div style="background: linear-gradient(135deg, #0F2547 0%, #173B6D 55%, #1D4ED8 100%);"
         class="rounded-3xl p-5 sm:p-6 text-white shadow-xl shadow-blue-950/15 border border-blue-400/20 relative overflow-hidden">
        <div class="absolute -right-12 -top-12 w-64 h-64 bg-sky-400/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute left-1/3 -bottom-16 w-64 h-64 bg-blue-400/15 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-5">
            <div class="flex items-start sm:items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-white/95 p-1.5 shadow-lg shadow-black/20 ring-2 ring-white/25 flex items-center justify-center flex-shrink-0">
                    <img src="{{ url_for('static', filename='images/logo_mitra.svg') }}" alt="Logo Monitoring Mitra" class="w-full h-full object-contain">
                </div>
                <div>
                    <div class="flex items-center gap-1.5 text-[11px] text-blue-200/80 mb-1.5">
                        <a href="{{ url_for('dashboard.index') }}" class="hover:text-white transition flex items-center gap-1">
                            <i data-lucide="home" class="w-3 h-3"></i> LENTERA
                        </a>
                        <span class="text-blue-300/50">/</span>
                        <span class="text-white font-semibold">Dashboard Mitra</span>
                    </div>

                    <div class="flex flex-wrap items-center gap-2.5">
                        <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-white">Dashboard Mitra</h1>
                        <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-[11px] font-semibold bg-white/15 text-sky-100 border border-white/20 backdrop-blur-sm">
                            <span class="w-1.5 h-1.5 rounded-full bg-sky-300"></span>
                            BPS Banyuwangi (3510)
                        </span>
                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-blue-950/40 text-blue-100 border border-white/15">
                            {{ total_mitra }} Mitra &bull; {{ total_kegiatan }} Kegiatan
                        </span>
                    </div>
                    <p class="text-xs text-blue-100/80 mt-1.5">Ringkasan data mitra statistik, sebaran 25 kecamatan, kegiatan per tim kerja, dan progres penugasan lapangan.</p>
                </div>
            </div>

            <!-- Action Buttons (Kontras Jelas di Atas Banner Biru) -->
            <div class="flex flex-wrap items-center gap-2 pt-1 lg:pt-0">
                <a href="{{ url_for('mitra.database') }}"
                   class="h-10 px-4 rounded-xl bg-white/10 hover:bg-white/20 text-white border border-white/20 font-semibold text-xs transition-all flex items-center gap-1.5 backdrop-blur-sm">
                    <i data-lucide="database" class="w-3.5 h-3.5 text-sky-200"></i>
                    <span>Data Mitra</span>
                </a>
                <a href="{{ url_for('mitra.template') }}"
                   class="h-10 px-4 rounded-xl bg-white/10 hover:bg-white/20 text-white border border-white/20 font-semibold text-xs transition-all flex items-center gap-1.5 backdrop-blur-sm">
                    <i data-lucide="file-up" class="w-3.5 h-3.5 text-sky-200"></i>
                    <span>Template &amp; Upload</span>
                </a>
                <a href="{{ url_for('mitra.penugasan') }}"
                   class="h-10 px-4 rounded-xl bg-white hover:bg-blue-50 text-blue-700 font-bold text-xs shadow-lg shadow-black/15 active:scale-95 transition-all flex items-center gap-1.5">
                    <i data-lucide="user-plus" class="w-3.5 h-3.5"></i>
                    <span>Tugaskan Mitra</span>
                </a>
            </div>
        </div>
    </div>

    <!-- 2. 4 Kartu Statistik Utama (Bersih, Rapi, Tanpa Persen) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

        <!-- Kartu 1: Total Mitra -->
        <a href="{{ url_for('mitra.database') }}"
           class="bg-white rounded-3xl p-5 border border-slate-200/80 shadow-soft hover:shadow-lg hover:border-blue-300 hover:-translate-y-0.5 transition-all relative overflow-hidden group">
            <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-blue-600 to-sky-400"></div>
            <div class="flex items-start justify-between">
                <div>
                    <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Total Mitra</p>
                    <p class="text-3xl font-black text-slate-900 mt-1.5 tracking-tight">{{ total_mitra }} <span class="text-xs font-semibold text-slate-400">Orang</span></p>
                </div>
                <div class="w-11 h-11 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-colors">
                    <i data-lucide="users" class="w-5 h-5"></i>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px]">
                <span class="text-slate-500">Cakupan Wilayah</span>
                <span class="font-bold text-blue-700">25 Kecamatan</span>
            </div>
        </a>

        <!-- Kartu 2: Total Kegiatan -->
        <a href="{{ url_for('mitra.monitoring') }}"
           class="bg-white rounded-3xl p-5 border border-slate-200/80 shadow-soft hover:shadow-lg hover:border-blue-300 hover:-translate-y-0.5 transition-all relative overflow-hidden group">
            <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-blue-600 to-sky-400"></div>
            <div class="flex items-start justify-between">
                <div>
                    <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Total Kegiatan</p>
                    <p class="text-3xl font-black text-slate-900 mt-1.5 tracking-tight">{{ total_kegiatan }} <span class="text-xs font-semibold text-slate-400">Kegiatan</span></p>
                </div>
                <div class="w-11 h-11 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-colors">
                    <i data-lucide="calendar-check-2" class="w-5 h-5"></i>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px]">
                <span class="text-slate-500">Distribusi Tim</span>
                <span class="font-bold text-blue-700">4 Tim Kerja BPS</span>
            </div>
        </a>

        <!-- Kartu 3: Penugasan Mitra -->
        <a href="{{ url_for('mitra.penugasan') }}"
           class="bg-white rounded-3xl p-5 border border-slate-200/80 shadow-soft hover:shadow-lg hover:border-blue-300 hover:-translate-y-0.5 transition-all relative overflow-hidden group">
            <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-blue-600 to-sky-400"></div>
            <div class="flex items-start justify-between">
                <div>
                    <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Penugasan Mitra</p>
                    <p class="text-3xl font-black text-blue-700 mt-1.5 tracking-tight">{{ total_penugasan }} <span class="text-xs font-semibold text-slate-400">Tugas</span></p>
                </div>
                <div class="w-11 h-11 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-colors">
                    <i data-lucide="clipboard-check" class="w-5 h-5"></i>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px]">
                <span class="text-slate-500">{{ penugasan_selesai }} Selesai</span>
                <span class="font-bold text-sky-600">{{ penugasan_proses }} Berjalan</span>
            </div>
        </a>

        <!-- Kartu 4: Total Honorarium & Nilai -->
        <a href="{{ url_for('mitra.rekapitulasi') }}"
           class="bg-white rounded-3xl p-5 border border-slate-200/80 shadow-soft hover:shadow-lg hover:border-blue-300 hover:-translate-y-0.5 transition-all relative overflow-hidden group">
            <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-sky-500 to-blue-600"></div>
            <div class="flex items-start justify-between">
                <div class="min-w-0">
                    <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Total Honorarium</p>
                    <p class="text-xl sm:text-2xl font-black font-mono text-blue-700 mt-2 truncate">Rp {{ "{:,}".format(total_honor_all).replace(',', '.') }}</p>
                </div>
                <div class="w-11 h-11 rounded-2xl bg-sky-50 text-sky-600 flex items-center justify-center shrink-0 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                    <i data-lucide="wallet" class="w-5 h-5"></i>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px]">
                <span class="text-slate-500">Nilai Rata-Rata</span>
                <span class="font-bold text-slate-800">{% if avg_score > 0 %}{{ avg_score }} / 100{% else %}Belum Dinilai{% endif %}</span>
            </div>
        </a>

    </div>

    <!-- 3. Grafik Sebaran Mitra + 4 Tim Kerja (Layout 2 Kolom Seimbang) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">

        <!-- Kolom Kiri (7/12): Grafik Sebaran Mitra per Kecamatan -->
        <div class="lg:col-span-7 bg-white rounded-3xl p-6 border border-slate-200/80 shadow-soft flex flex-col justify-between">
            <div class="flex items-center justify-between gap-3 pb-4 border-b border-slate-100 mb-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                        <i data-lucide="bar-chart-3" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h2 class="text-sm sm:text-base font-extrabold text-slate-900">Sebaran Mitra per Kecamatan</h2>
                        <p class="text-xs text-slate-500">Distribusi mitra statistik di wilayah Kabupaten Banyuwangi</p>
                    </div>
                </div>
                <a href="{{ url_for('mitra.database') }}" class="text-xs font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1 whitespace-nowrap">
                    <span>Lihat Data</span>
                    <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                </a>
            </div>

            <div class="h-64 relative">
                <canvas id="chartSebaranKecamatan"></canvas>
            </div>
        </div>

        <!-- Kolom Kanan (5/12): 4 Tim Kerja Teknis (Grid 2x2 Rapi) -->
        <div class="lg:col-span-5 bg-white rounded-3xl p-6 border border-slate-200/80 shadow-soft flex flex-col justify-between">
            <div class="flex items-center justify-between gap-2 pb-4 border-b border-slate-100 mb-4">
                <div>
                    <h2 class="text-sm sm:text-base font-extrabold text-slate-900">Kegiatan per Tim Kerja</h2>
                    <p class="text-xs text-slate-500">Klik kartu tim untuk melihat daftar kegiatannya</p>
                </div>
                <a href="{{ url_for('mitra.monitoring') }}" class="text-xs font-bold text-blue-600 hover:underline whitespace-nowrap">Semua &rarr;</a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 flex-1">
                <!-- Tim Distribusi -->
                <a href="{{ url_for('mitra.monitoring', tim='Tim Distribusi') }}"
                   class="p-4 rounded-2xl bg-slate-50/80 hover:bg-blue-50/70 border border-slate-200/80 hover:border-blue-300 transition-all group flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <div class="w-9 h-9 rounded-xl bg-white text-blue-600 border border-blue-100 flex items-center justify-center shadow-2xs group-hover:bg-blue-600 group-hover:text-white transition-colors">
                            <i data-lucide="truck" class="w-4 h-4"></i>
                        </div>
                        <span class="text-lg font-black text-blue-700 font-mono">{{ count_keg_distribusi }}</span>
                    </div>
                    <div class="mt-3">
                        <h3 class="text-xs font-extrabold text-slate-900 group-hover:text-blue-700 transition-colors">Tim Distribusi</h3>
                        <p class="text-[10px] text-slate-500 mt-0.5">Harga, Perdagangan &amp; Jasa</p>
                    </div>
                </a>

                <!-- Tim Neraca -->
                <a href="{{ url_for('mitra.monitoring', tim='Tim Neraca') }}"
                   class="p-4 rounded-2xl bg-slate-50/80 hover:bg-blue-50/70 border border-slate-200/80 hover:border-blue-300 transition-all group flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <div class="w-9 h-9 rounded-xl bg-white text-blue-600 border border-blue-100 flex items-center justify-center shadow-2xs group-hover:bg-blue-600 group-hover:text-white transition-colors">
                            <i data-lucide="scale" class="w-4 h-4"></i>
                        </div>
                        <span class="text-lg font-black text-blue-700 font-mono">{{ count_keg_neraca }}</span>
                    </div>
                    <div class="mt-3">
                        <h3 class="text-xs font-extrabold text-slate-900 group-hover:text-blue-700 transition-colors">Tim Neraca</h3>
                        <p class="text-[10px] text-slate-500 mt-0.5">Neraca &amp; Ekonomi Wilayah</p>
                    </div>
                </a>

                <!-- Tim Produksi -->
                <a href="{{ url_for('mitra.monitoring', tim='Tim Produksi') }}"
                   class="p-4 rounded-2xl bg-slate-50/80 hover:bg-blue-50/70 border border-slate-200/80 hover:border-blue-300 transition-all group flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <div class="w-9 h-9 rounded-xl bg-white text-blue-600 border border-blue-100 flex items-center justify-center shadow-2xs group-hover:bg-blue-600 group-hover:text-white transition-colors">
                            <i data-lucide="sprout" class="w-4 h-4"></i>
                        </div>
                        <span class="text-lg font-black text-blue-700 font-mono">{{ count_keg_produksi }}</span>
                    </div>
                    <div class="mt-3">
                        <h3 class="text-xs font-extrabold text-slate-900 group-hover:text-blue-700 transition-colors">Tim Produksi</h3>
                        <p class="text-[10px] text-slate-500 mt-0.5">Pertanian &amp; Industri</p>
                    </div>
                </a>

                <!-- Tim PLS -->
                <a href="{{ url_for('mitra.monitoring', tim='Tim PLS') }}"
                   class="p-4 rounded-2xl bg-slate-50/80 hover:bg-blue-50/70 border border-slate-200/80 hover:border-blue-300 transition-all group flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <div class="w-9 h-9 rounded-xl bg-white text-sky-600 border border-sky-100 flex items-center justify-center shadow-2xs group-hover:bg-blue-600 group-hover:text-white transition-colors">
                            <i data-lucide="database" class="w-4 h-4"></i>
                        </div>
                        <span class="text-lg font-black text-blue-700 font-mono">{{ count_keg_pls }}</span>
                    </div>
                    <div class="mt-3">
                        <h3 class="text-xs font-extrabold text-slate-900 group-hover:text-blue-700 transition-colors">Tim PLS</h3>
                        <p class="text-[10px] text-slate-500 mt-0.5">Pengolahan Data &amp; TI</p>
                    </div>
                </a>
            </div>
        </div>

    </div>

    <!-- 4. Baris Bawah: Penugasan Terbaru & Kegiatan Berjalan -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">

        <!-- Kolom Kiri (7/12): Penugasan Mitra Terbaru -->
        <div class="lg:col-span-7 bg-white rounded-3xl p-6 border border-slate-200/80 shadow-soft flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
                    <div>
                        <h2 class="text-base font-extrabold text-slate-900">Penugasan Mitra Terbaru</h2>
                        <p class="text-xs text-slate-500">Daftar penugasan terbaru beserta jumlah dokumen yang dikumpulkan</p>
                    </div>
                    <a href="{{ url_for('mitra.penugasan') }}" class="text-xs font-bold text-blue-600 hover:underline flex items-center gap-1 whitespace-nowrap">
                        <span>Kelola Penugasan</span>
                        <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                    </a>
                </div>

                <div class="overflow-x-auto rounded-2xl border border-slate-200/80">
                    <table class="w-full text-left text-xs">
                        <thead>
                            <tr class="bg-slate-50/90 border-b border-slate-200/80 text-slate-600 uppercase font-bold text-[10px] tracking-wider">
                                <th class="py-3 px-4">Nama Mitra</th>
                                <th class="py-3 px-4">Kegiatan</th>
                                <th class="py-3 px-4 text-center">Dokumen</th>
                                <th class="py-3 px-4 text-center">Status</th>
                                <th class="py-3 px-4 text-right">Update</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            {% for item in penugasan_terbaru %}
                            <tr class="hover:bg-blue-50/40 transition">
                                <td class="py-3 px-4 whitespace-nowrap">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 font-extrabold text-[11px] flex items-center justify-center shrink-0">
                                            {{ (item.mitra.nama_lengkap or 'M')[:1]|upper }}
                                        </div>
                                        <div>
                                            <div class="font-bold text-slate-900">{{ item.mitra.nama_lengkap }}</div>
                                            <div class="text-[10px] text-slate-400">{{ item.mitra.kecamatan }}</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 px-4">
                                    <div class="font-semibold text-slate-800 line-clamp-1">{{ item.kegiatan.nama_kegiatan }}</div>
                                    <div class="text-[10px] text-slate-400">{{ item.kegiatan.tim_kerja }} &bull; {{ item.peran }}</div>
                                </td>
                                <td class="py-3 px-4 text-center whitespace-nowrap font-mono font-bold text-slate-700">
                                    {{ item.realisasi_dokumen }} / {{ item.target_dokumen }} Dok
                                </td>
                                <td class="py-3 px-4 text-center whitespace-nowrap">
                                    {% if item.status == 'SELESAI' %}
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">Selesai</span>
                                    {% else %}
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-sky-50 text-sky-700 border border-sky-200">Proses</span>
                                    {% endif %}
                                </td>
                                <td class="py-3 px-4 text-right whitespace-nowrap">
                                    <button type="button"
                                            onclick="openModalUpdateProgress({{ item.id }}, '{{ item.mitra.nama_lengkap|e }}', {{ item.realisasi_dokumen }}, {{ item.target_dokumen }})"
                                            class="px-2.5 py-1 rounded-lg bg-blue-50 hover:bg-blue-600 text-blue-700 hover:text-white font-bold text-[11px] border border-blue-200/80 transition">
                                        Update
                                    </button>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="5" class="py-12 px-4 text-center">
                                    <div class="flex flex-col items-center gap-2">
                                        <div class="w-11 h-11 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center">
                                            <i data-lucide="clipboard-list" class="w-5 h-5"></i>
                                        </div>
                                        <p class="font-bold text-slate-800 text-xs">Belum Ada Penugasan Mitra</p>
                                        <p class="text-[11px] text-slate-400">Klik tombol <strong>Tugaskan Mitra</strong> di atas untuk mulai membagi tugas.</p>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Kolom Kanan (5/12): Kegiatan Berjalan & Pintasan Menu -->
        <div class="lg:col-span-5 bg-white rounded-3xl p-6 border border-slate-200/80 shadow-soft flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
                    <div>
                        <h2 class="text-base font-extrabold text-slate-900">Kegiatan Aktif Terbaru</h2>
                        <p class="text-xs text-slate-500">Daftar kegiatan yang sedang berjalan di BPS Banyuwangi</p>
                    </div>
                    <a href="{{ url_for('mitra.monitoring') }}" class="text-xs font-bold text-blue-600 hover:underline whitespace-nowrap">Lihat Semua &rarr;</a>
                </div>

                <div class="space-y-2.5">
                    {% for keg in kegiatan_aktif[:5] %}
                    <a href="{{ url_for('mitra.monitoring_detail', kegiatan_id=keg.id) }}"
                       class="block p-3.5 rounded-2xl bg-slate-50/80 hover:bg-blue-50/70 border border-slate-200/70 hover:border-blue-300 transition-all group">
                        <div class="flex items-start justify-between gap-2">
                            <div class="min-w-0">
                                <h3 class="text-xs font-bold text-slate-900 group-hover:text-blue-700 truncate">{{ keg.nama_kegiatan }}</h3>
                                <div class="flex items-center gap-2 mt-1 text-[10px] text-slate-500">
                                    <span class="px-2 py-0.2 rounded-md bg-white border border-blue-200/70 text-blue-700 font-bold">{{ keg.tim_kerja }}</span>
                                    <span>{{ keg.bulan or '' }} {{ keg.tahun }}</span>
                                </div>
                            </div>
                            <span class="px-2.5 py-1 rounded-full bg-white border border-slate-200 text-slate-700 font-bold text-[10px] whitespace-nowrap shrink-0">
                                {{ keg.penugasan_mitra.count() }} Mitra
                            </span>
                        </div>
                    </a>
                    {% else %}
                    <div class="py-10 text-center text-slate-400 text-xs">
                        Belum ada kegiatan aktif. Upload melalui <strong>Template &amp; Upload</strong>.
                    </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Pintasan Cepat Bawah -->
            <div class="mt-5 pt-4 border-t border-slate-100 grid grid-cols-2 gap-2.5">
                <a href="{{ url_for('mitra.evaluasi') }}"
                   class="py-2.5 px-3 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200/80 text-xs font-bold text-center transition flex items-center justify-center gap-1.5">
                    <i data-lucide="award" class="w-3.5 h-3.5"></i>
                    <span>Penilaian Mitra</span>
                </a>
                <a href="{{ url_for('mitra.rekapitulasi') }}"
                   class="py-2.5 px-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold text-center transition flex items-center justify-center gap-1.5 shadow-sm">
                    <i data-lucide="file-spreadsheet" class="w-3.5 h-3.5"></i>
                    <span>Laporan &amp; Honor</span>
                </a>
            </div>
        </div>

    </div>

</div>

<!-- Modal Quick Update Progres Dokumen -->
<div id="modalUpdateProgres" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl border border-slate-100">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
            <h3 class="text-sm font-extrabold text-slate-900">Perbarui Realisasi Dokumen</h3>
            <button onclick="document.getElementById('modalUpdateProgres').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
        <form id="formUpdateProgres" method="POST" class="space-y-4">
            <div class="p-3 rounded-2xl bg-blue-50/70 border border-blue-100">
                <p class="text-[10px] font-bold uppercase tracking-wider text-blue-600">Nama Mitra</p>
                <p id="modalMitraName" class="text-sm font-extrabold text-slate-900 mt-0.5"></p>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1.5">Jumlah Dokumen Selesai</label>
                <div class="flex items-center gap-2">
                    <input type="number" id="inputRealisasi" name="realisasi_dokumen" min="0" required class="flex-1 px-3 py-2 rounded-xl border border-slate-200 text-sm font-bold text-slate-800">
                    <span class="text-xs font-semibold text-slate-500">/ <span id="modalTargetDokumen"></span> Dok</span>
                </div>
            </div>
            <div class="pt-2 flex justify-end gap-2">
                <button type="button" onclick="document.getElementById('modalUpdateProgres').classList.add('hidden')" class="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100">Batal</button>
                <button type="submit" class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow-sm transition">Simpan Progres</button>
            </div>
        </form>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const ctxKec = document.getElementById('chartSebaranKecamatan');
    if (ctxKec && typeof Chart !== 'undefined') {
        const labels = {{ chart_kec_labels|tojson }};
        const values = {{ chart_kec_values|tojson }};
        new Chart(ctxKec, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Jumlah Mitra',
                    data: values,
                    backgroundColor: 'rgba(37, 99, 235, 0.85)',
                    hoverBackgroundColor: '#1D4ED8',
                    borderRadius: 6,
                    maxBarThickness: 28
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: (ctx) => ` ${ctx.raw} Mitra`
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1, font: { size: 10 }, color: '#64748B' },
                        grid: { color: '#F1F5F9' }
                    },
                    x: {
                        ticks: { font: { size: 9 }, color: '#64748B', maxRotation: 45, minRotation: 0 },
                        grid: { display: false }
                    }
                }
            }
        });
    }
});

function openModalUpdateProgress(id, name, currentReal, target) {
    const modal = document.getElementById('modalUpdateProgres');
    const form = document.getElementById('formUpdateProgres');
    form.action = `/mitra/penugasan/${id}/update-progress`;
    document.getElementById('modalMitraName').innerText = name;
    document.getElementById('inputRealisasi').value = currentReal;
    document.getElementById('modalTargetDokumen').innerText = target;
    modal.classList.remove('hidden');
}
</script>
{% endblock %}
