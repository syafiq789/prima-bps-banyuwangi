{% extends 'base.j2' %}

{% block title %}Laporan & Honor Mitra - LENTERA BPS Banyuwangi{% endblock %}

{% block content %}
<div class="space-y-6">

    <!-- 1. Header Banner Executive Blue -->
    <div style="background: linear-gradient(135deg, #0F2547 0%, #173B6D 55%, #1D4ED8 100%);"
         class="rounded-3xl p-5 sm:p-6 text-white shadow-xl shadow-blue-950/15 border border-blue-400/20 relative overflow-hidden">
        <div class="absolute -right-12 -top-12 w-60 h-60 bg-sky-400/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute left-1/3 -bottom-16 w-64 h-64 bg-blue-400/15 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-5">
            <div class="flex items-start sm:items-center gap-4 min-w-0">
                <div class="w-14 h-14 rounded-2xl bg-white/95 p-1.5 shadow-lg shadow-black/20 ring-2 ring-white/25 flex items-center justify-center flex-shrink-0">
                    <img src="{{ url_for('static', filename='images/logo_mitra.svg') }}" alt="Logo Monitoring Mitra" class="w-full h-full object-contain">
                </div>
                <div class="min-w-0">
                    <div class="flex items-center gap-1.5 text-[11px] text-blue-200/80 mb-1.5">
                        <a href="{{ url_for('dashboard.index') }}" class="hover:text-white transition flex items-center gap-1">
                            <i data-lucide="home" class="w-3 h-3"></i> LENTERA
                        </a>
                        <span class="text-blue-300/50">/</span>
                        <a href="{{ url_for('mitra.dashboard') }}" class="hover:text-white transition">Monitoring Mitra</a>
                        <span class="text-blue-300/50">/</span>
                        <span class="text-white font-semibold">Laporan &amp; Honor</span>
                    </div>

                    <div class="flex flex-wrap items-center gap-2.5">
                        <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-white">Laporan &amp; Honor Mitra</h1>
                        <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-[11px] font-semibold bg-white/15 text-sky-100 border border-white/20 backdrop-blur-sm">
                            <span class="w-1.5 h-1.5 rounded-full bg-sky-300"></span>
                            BPS Banyuwangi (3510)
                        </span>
                    </div>
                    <p class="text-xs text-blue-100/80 mt-1.5">Ringkasan kegiatan per tim kerja, jumlah penugasan, penilaian mitra, dan total honorarium</p>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-2 pt-1 lg:pt-0 flex-shrink-0">
                <button onclick="window.print()"
                        class="h-10 px-4 rounded-xl bg-white/10 hover:bg-white/20 text-white border border-white/20 font-semibold text-xs transition-all flex items-center gap-1.5 backdrop-blur-sm whitespace-nowrap">
                    <i data-lucide="printer" class="w-3.5 h-3.5 text-sky-200"></i>
                    <span>Cetak Laporan</span>
                </button>
                <a href="{{ url_for('mitra.database') }}"
                   class="h-10 px-4 rounded-xl bg-white hover:bg-blue-50 text-blue-700 font-bold text-xs shadow-lg shadow-black/15 active:scale-95 transition-all flex items-center gap-1.5 whitespace-nowrap">
                    <i data-lucide="users" class="w-3.5 h-3.5"></i>
                    <span>Data Mitra</span>
                </a>
            </div>
        </div>
    </div>

    <!-- 2. Ringkasan 4 Metrik Utama Monitoring Mitra -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-soft hover:border-blue-300 transition-all">
            <div class="flex items-center justify-between text-slate-500">
                <span class="text-xs font-semibold">Total Mitra</span>
                <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                    <i data-lucide="users" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="mt-2.5 flex items-baseline gap-1.5">
                <span class="text-2xl font-black text-slate-900">{{ rekap_data|length }}</span>
                <span class="text-xs text-slate-400 font-medium">Orang</span>
            </div>
            <p class="text-[11px] text-slate-400 mt-1">Terdaftar di Data Mitra</p>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-soft hover:border-blue-300 transition-all">
            <div class="flex items-center justify-between text-slate-500">
                <span class="text-xs font-semibold">Total Kegiatan</span>
                <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                    <i data-lucide="calendar" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="mt-2.5 flex items-baseline gap-1.5">
                <span class="text-2xl font-black text-slate-900">{{ total_kegiatan }}</span>
                <span class="text-xs text-slate-400 font-medium">Kegiatan</span>
            </div>
            <p class="text-[11px] text-slate-400 mt-1">Tersebar di 4 Tim Kerja</p>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-soft hover:border-blue-300 transition-all">
            <div class="flex items-center justify-between text-slate-500">
                <span class="text-xs font-semibold">Total Penugasan</span>
                <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                    <i data-lucide="clipboard-list" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="mt-2.5 flex items-baseline gap-1.5">
                <span class="text-2xl font-black text-slate-900">{{ total_penugasan }}</span>
                <span class="text-xs text-slate-400 font-medium">Tugas</span>
            </div>
            <p class="text-[11px] text-slate-400 mt-1">Alokasi di Penugasan Mitra</p>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-soft hover:border-blue-300 transition-all">
            <div class="flex items-center justify-between text-slate-500">
                <span class="text-xs font-semibold">Total Honor</span>
                <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                    <i data-lucide="wallet" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="mt-2.5">
                <span class="text-2xl font-black text-blue-700 font-mono">Rp {{ "{:,}".format(total_honor_all).replace(',', '.') }}</span>
            </div>
            <p class="text-[11px] text-slate-400 mt-1">Akumulasi seluruh penugasan</p>
        </div>
    </div>

    <!-- 3. Ringkasan Kegiatan & Honor per 4 Tim Kerja -->
    <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-soft">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-slate-100 mb-5">
            <div>
                <h2 class="text-base font-extrabold text-slate-900">Ringkasan per Tim Kerja</h2>
                <p class="text-xs text-slate-500">Rekap kegiatan, penugasan mitra, dan total honor pada masing-masing tim kerja</p>
            </div>
            <a href="{{ url_for('mitra.monitoring') }}" class="text-xs font-bold text-blue-600 hover:underline inline-flex items-center gap-1">
                <span>Lihat Daftar Kegiatan</span>
                <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
            </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {% for tim in rekap_tim_kerja %}
            <div class="p-4 rounded-2xl bg-slate-50/70 hover:bg-blue-50/50 border border-slate-200/80 hover:border-blue-300 transition-all flex flex-col justify-between gap-3">
                <div class="flex items-start justify-between gap-2">
                    <div>
                        <h3 class="text-sm font-extrabold text-slate-900">{{ tim.nama }}</h3>
                        <p class="text-[11px] text-slate-500 mt-0.5 line-clamp-1">{{ tim.desc }}</p>
                    </div>
                    <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 border border-blue-100 flex items-center justify-center flex-shrink-0">
                        <i data-lucide="{{ tim.icon }}" class="w-4 h-4"></i>
                    </div>
                </div>

                <div class="space-y-1.5 pt-2.5 border-t border-slate-200/70 text-xs">
                    <div class="flex items-center justify-between">
                        <span class="text-slate-500">Kegiatan</span>
                        <span class="font-bold text-slate-800">{{ tim.total_kegiatan }} Kegiatan</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-500">Penugasan</span>
                        <span class="font-bold text-slate-800">{{ tim.total_tugas }} Tugas</span>
                    </div>
                    <div class="flex items-center justify-between pt-1">
                        <span class="text-slate-500">Total Honor</span>
                        <span class="font-mono font-extrabold text-blue-700">Rp {{ "{:,}".format(tim.total_honor).replace(',', '.') }}</span>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

    <!-- 4. Tabel Laporan Kinerja & Honor per Mitra -->
    <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-soft">
        <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-4 pb-5 border-b border-slate-100 mb-4">
            <div class="space-y-1.5">
                <div class="flex flex-wrap items-center gap-2.5">
                    <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                        <i data-lucide="file-spreadsheet" class="w-4.5 h-4.5"></i>
                    </div>
                    <div>
                        <div class="flex flex-wrap items-center gap-2">
                            <h2 class="text-base font-extrabold text-slate-900">Laporan Rinci Kinerja, Kegiatan &amp; Honor per Mitra</h2>
                            <span class="px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200/70 text-[10px] font-bold">
                                {{ rekap_data|length }} Mitra Terdaftar
                            </span>
                        </div>
                        <p class="text-xs text-slate-500 mt-0.5 leading-relaxed">
                            Rekapitulasi lengkap seluruh mitra statistik BPS Kabupaten Banyuwangi mencakup identitas, wilayah domisili, tim kerja &amp; kegiatan yang diikuti, status penyelesaian tugas, hasil penilaian pengawas, hingga akumulasi honor yang diterima.
                        </p>
                    </div>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 shrink-0">
                <select id="filterPredikatMitra"
                        onchange="filterRekapMitra()"
                        class="px-3 py-2 text-xs rounded-xl border border-slate-200 bg-slate-50/70 focus:bg-white focus:border-blue-500 outline-none text-slate-700 font-semibold transition">
                    <option value="">Semua Kategori Kinerja</option>
                    <option value="sangat baik">Sangat Baik (A)</option>
                    <option value="baik (b)">Baik (B)</option>
                    <option value="cukup">Cukup (C)</option>
                    <option value="kurang">Kurang (D)</option>
                    <option value="belum dinilai">Belum Dinilai</option>
                </select>
                <div class="relative w-full sm:w-64">
                    <i data-lucide="search" class="w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                    <input type="text"
                           id="searchRekapMitra"
                           onkeyup="filterRekapMitra()"
                           placeholder="Cari nama, ID Sobat, kecamatan, tim..."
                           class="w-full pl-9 pr-3 py-2 text-xs rounded-xl border border-slate-200 bg-slate-50/70 focus:bg-white focus:border-blue-500 outline-none transition">
                </div>
            </div>
        </div>

        <!-- Keterangan Singkat Penilaian & Status -->
        <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-2.5 mb-4 rounded-2xl bg-blue-50/60 border border-blue-100 text-[11px] text-slate-600">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
                <span class="font-bold text-blue-800 inline-flex items-center gap-1.5">
                    <i data-lucide="info" class="w-3.5 h-3.5 text-blue-600"></i>
                    Panduan Kategori Nilai:
                </span>
                <span><strong class="text-blue-700">Sangat Baik (A)</strong> : 90–100</span>
                <span><strong class="text-blue-700">Baik (B)</strong> : 80–89</span>
                <span><strong class="text-sky-700">Cukup (C)</strong> : 70–79</span>
                <span><strong class="text-slate-700">Kurang (D)</strong> : &lt; 70</span>
            </div>
            <span class="text-[10px] text-slate-500">Data diperbarui otomatis dari menu Penugasan &amp; Penilaian Mitra</span>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-slate-200/80">
            <table class="w-full text-left text-xs" id="tableRekapMitra">
                <thead>
                    <tr class="bg-slate-50/90 border-b border-slate-200/80 text-slate-600 uppercase font-bold text-[10px] tracking-wider">
                        <th class="py-3.5 px-3.5 text-center w-10">No</th>
                        <th class="py-3.5 px-4">Identitas &amp; Kontak Mitra</th>
                        <th class="py-3.5 px-4">Wilayah Domisili</th>
                        <th class="py-3.5 px-4">Tim Kerja &amp; Kegiatan</th>
                        <th class="py-3.5 px-4 text-center">Progres Tugas</th>
                        <th class="py-3.5 px-4 text-center">Nilai Evaluasi</th>
                        <th class="py-3.5 px-4 text-center">Kategori Kinerja</th>
                        <th class="py-3.5 px-4 text-right">Total Honor Diterima</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for r in rekap_data %}
                    <tr class="rekap-row hover:bg-blue-50/40 transition"
                        data-search="{{ (r.mitra.nama_lengkap ~ ' ' ~ r.mitra.id_sobat ~ ' ' ~ (r.mitra.kecamatan or '') ~ ' ' ~ (r.mitra.desa or '') ~ ' ' ~ (' '.join(r.tim_list)) ~ ' ' ~ (' '.join(r.kegiatan_list)))|lower }}"
                        data-predikat="{{ r.predikat|lower }}">
                        <td class="py-3.5 px-3.5 text-center font-mono text-slate-400 font-semibold">
                            {{ loop.index }}
                        </td>
                        <td class="py-3.5 px-4">
                            <div class="font-bold text-slate-900">{{ r.mitra.nama_lengkap }}</div>
                            <div class="text-[10px] text-slate-500 font-mono mt-0.5">ID Sobat: {{ r.mitra.id_sobat }}</div>
                            {% if r.mitra.no_hp or r.mitra.email %}
                            <div class="text-[10px] text-slate-400 mt-0.5">
                                {{ r.mitra.no_hp or '-' }}{% if r.mitra.email %} &bull; {{ r.mitra.email }}{% endif %}
                            </div>
                            {% endif %}
                        </td>
                        <td class="py-3.5 px-4">
                            <div class="font-semibold text-slate-800">{{ r.mitra.kecamatan or 'Belum Diisi' }}</div>
                            <div class="text-[10px] text-slate-500 mt-0.5">Desa/Kel: {{ r.mitra.desa or '-' }}</div>
                        </td>
                        <td class="py-3.5 px-4">
                            {% if r.tim_list %}
                            <div class="flex flex-wrap gap-1 mb-1">
                                {% for t in r.tim_list %}
                                <span class="px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 border border-blue-200/70 text-[10px] font-bold">{{ t }}</span>
                                {% endfor %}
                            </div>
                            <div class="text-[10px] text-slate-500 leading-snug">
                                {{ r.kegiatan_list[:2]|join(', ') }}{% if r.kegiatan_list|length > 2 %} <span class="text-blue-600 font-semibold">+{{ r.kegiatan_list|length - 2 }} kegiatan lainnya</span>{% endif %}
                            </div>
                            {% else %}
                            <span class="text-[11px] text-slate-400 italic">Belum ada kegiatan ditugaskan</span>
                            {% endif %}
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700 font-bold text-[11px] border border-blue-200/70">
                                {{ r.total_tugas }} Total Tugas
                            </span>
                            <div class="text-[10px] text-slate-500 mt-1">
                                {{ r.tugas_selesai }} Selesai &bull; {{ r.tugas_berjalan }} Berjalan
                            </div>
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            {% if r.avg_score > 0 %}
                            <div class="font-mono font-extrabold text-slate-900 text-xs">{{ r.avg_score }} <span class="text-[10px] font-normal text-slate-400">/ 100</span></div>
                            <div class="text-[10px] text-slate-500 mt-0.5">Dari {{ r.jumlah_eval }} penilaian</div>
                            {% else %}
                            <span class="text-slate-400 font-normal">-</span>
                            <div class="text-[10px] text-slate-400 mt-0.5">Belum ada nilai</div>
                            {% endif %}
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold {% if r.avg_score >= 80 %} bg-blue-50 text-blue-700 border border-blue-200 {% elif r.avg_score > 0 %} bg-sky-50 text-sky-700 border border-sky-200 {% else %} bg-slate-100 text-slate-500 {% endif %}">
                                {{ r.predikat }}
                            </span>
                        </td>
                        <td class="py-3.5 px-4 text-right whitespace-nowrap">
                            <div class="font-mono font-extrabold text-blue-700 text-xs">
                                Rp {{ "{:,}".format(r.total_honor).replace(',', '.') }}
                            </div>
                            <div class="text-[10px] text-slate-400 mt-0.5">Akumulasi honor</div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="8" class="py-12 px-6 text-center">
                            <div class="max-w-md mx-auto space-y-2.5">
                                <div class="w-11 h-11 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center mx-auto">
                                    <i data-lucide="file-clock" class="w-5 h-5"></i>
                                </div>
                                <div>
                                    <h3 class="text-sm font-extrabold text-slate-800">Menunggu Laporan dari Fitur Monitoring Mitra</h3>
                                    <p class="text-xs text-slate-500 mt-1 leading-relaxed">
                                        Laporan kinerja, progres kegiatan, nilai evaluasi, dan akumulasi honor mitra akan tampil otomatis di sini setelah data masuk dari fitur <strong>Monitoring Mitra</strong> lainnya.
                                    </p>
                                </div>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

<script>
    function filterRekapMitra() {
        const q = (document.getElementById('searchRekapMitra')?.value || '').toLowerCase().trim();
        const pred = (document.getElementById('filterPredikatMitra')?.value || '').toLowerCase().trim();
        document.querySelectorAll('#tableRekapMitra .rekap-row').forEach(row => {
            const hay = row.getAttribute('data-search') || '';
            const rowPred = row.getAttribute('data-predikat') || '';
            const matchSearch = !q || hay.includes(q);
            const matchPred = !pred || rowPred.includes(pred);
            row.style.display = (matchSearch && matchPred) ? '' : 'none';
        });
    }
</script>
{% endblock %}
